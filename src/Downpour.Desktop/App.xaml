<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Downpour_Desktop.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Downpour_Desktop"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Other merged dictionaries here -->
            </ResourceDictionary.MergedDictionaries>
            <Color x:Key="DownpourAccentColor">#FF53DDF2</Color>
            <SolidColorBrush x:Key="DownpourAccentBrush" Color="{StaticResource DownpourAccentColor}" />
            <SolidColorBrush x:Key="DownpourSurfaceBrush" Color="#F00A1422" />
            <SolidColorBrush x:Key="DownpourSurfaceElevatedBrush" Color="#F5131E30" />
            <SolidColorBrush x:Key="DownpourStrokeBrush" Color="#6848B9D1" />
            <SolidColorBrush x:Key="DownpourMutedStrokeBrush" Color="#3C8BB6C7" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
