<?xml version="1.0" encoding="utf-8"?>
<!--
    Downpour "Storm HUD" theme: neon cyan / electric blue / magenta / violet with orange and red for warnings, over the
    rain backdrop. Overrides WinUI's own control resources so every standard control (buttons, toggles, sliders, lists,
    text boxes, navigation, progress) picks it up without per-page markup. Severity colors stay distinct from the brand
    colors, and text keeps at least 4.5:1 contrast on the panel color.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <!-- Text -->
            <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FFE9F8FF" />
            <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#FFA9CDE0" />
            <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#FF7FA2B8" />
            <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#FF4D6A7D" />
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#FF00E5FF" />
            <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#FF5CEEFF" />
            <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#FF2F8BFF" />
            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FF021018" />
            <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#CC021018" />
            <SolidColorBrush x:Key="TextOnAccentFillColorDisabledBrush" Color="#88021018" />

            <!-- Accent fills (primary buttons, toggles, progress, selection) -->
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FF00E5FF" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#E600E5FF" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#CC00C4DA" />
            <SolidColorBrush x:Key="AccentFillColorDisabledBrush" Color="#3300E5FF" />
            <SolidColorBrush x:Key="AccentControlElevationBorderBrush" Color="#FF8AF6FF" />

            <!-- Standard control fills: translucent glass tinted cyan -->
            <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#2A0C2A44" />
            <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#3A00E5FF" />
            <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#2200E5FF" />
            <SolidColorBrush x:Key="ControlFillColorDisabledBrush" Color="#14102030" />
            <SolidColorBrush x:Key="ControlFillColorInputActiveBrush" Color="#E6040C1A" />
            <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#7000E5FF" />
            <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="#A000E5FF" />
            <SolidColorBrush x:Key="ControlStrongStrokeColorDefaultBrush" Color="#C000E5FF" />
            <SolidColorBrush x:Key="ControlStrongFillColorDefaultBrush" Color="#C09CC3D8" />
            <SolidColorBrush x:Key="ControlAltFillColorSecondaryBrush" Color="#33061428" />
            <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#2600E5FF" />
            <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#1800E5FF" />
            <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#C8071226" />
            <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#D80C1A33" />
            <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#5520C8FF" />
            <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#3320C8FF" />
            <SolidColorBrush x:Key="SurfaceStrokeColorFlyoutBrush" Color="#9000E5FF" />
            <SolidColorBrush x:Key="FocusStrokeColorOuterBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="FocusStrokeColorInnerBrush" Color="#FF00E5FF" />

            <!-- Buttons -->
            <SolidColorBrush x:Key="ButtonBackground" Color="#2A0C2A44" />
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#3D00E5FF" />
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#5500E5FF" />
            <SolidColorBrush x:Key="ButtonBorderBrush" Color="#8000E5FF" />
            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#FF00E5FF" />
            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#FFFF2BD6" />
            <SolidColorBrush x:Key="ButtonForeground" Color="#FFE9F8FF" />
            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="AccentButtonBackground" Color="#FF00E5FF" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#FF5CEEFF" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#FFFF2BD6" />
            <SolidColorBrush x:Key="AccentButtonForeground" Color="#FF021018" />
            <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#FF021018" />
            <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#FF021018" />
            <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="#FF8AF6FF" />

            <!-- Toggles, checkboxes, sliders -->
            <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#FF00E5FF" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#FF5CEEFF" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FF021018" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="#AA9CC3D8" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="#FF00E5FF" />
            <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="#FF5CEEFF" />
            <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="#FF021018" />
            <SolidColorBrush x:Key="SliderTrackValueFill" Color="#FF00E5FF" />
            <SolidColorBrush x:Key="SliderThumbBackground" Color="#FF00E5FF" />

            <!-- Text input -->
            <SolidColorBrush x:Key="TextControlBackground" Color="#B0040C1A" />
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#C0081830" />
            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#E6040C1A" />
            <SolidColorBrush x:Key="TextControlBorderBrush" Color="#6000E5FF" />
            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#A000E5FF" />
            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#FF00E5FF" />
            <SolidColorBrush x:Key="TextControlForeground" Color="#FFE9F8FF" />
            <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#FF6F93A8" />

            <!-- Lists and navigation -->
            <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#2200E5FF" />
            <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#3300E5FF" />
            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#4400E5FF" />
            <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#FF00E5FF" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#FF00E5FF" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPointerOver" Color="#FF5CEEFF" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#2600E5FF" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="#3600E5FF" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="#1A00E5FF" />
            <SolidColorBrush x:Key="NavigationViewItemHeaderForeground" Color="#FFFF2BD6" />
            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#B8030A16" />
            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#E0030A16" />
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="#4020C8FF" />

            <!-- Progress and info -->
            <SolidColorBrush x:Key="ProgressBarForeground" Color="#FF00E5FF" />
            <SolidColorBrush x:Key="ProgressBarBackground" Color="#2200E5FF" />
            <SolidColorBrush x:Key="ProgressRingForegroundThemeBrush" Color="#FF00E5FF" />
            <SolidColorBrush x:Key="InfoBarInformationalSeverityBackgroundBrush" Color="#E0071A33" />
            <SolidColorBrush x:Key="InfoBarSuccessSeverityBackgroundBrush" Color="#E0062A24" />
            <SolidColorBrush x:Key="InfoBarWarningSeverityBackgroundBrush" Color="#E0302106" />
            <SolidColorBrush x:Key="InfoBarErrorSeverityBackgroundBrush" Color="#E0330815" />
            <SolidColorBrush x:Key="InfoBarBorderBrush" Color="#6000E5FF" />
            <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="#FFFF4D73" />
            <SolidColorBrush x:Key="SystemFillColorCautionBrush" Color="#FFFFCB47" />
            <SolidColorBrush x:Key="SystemFillColorSuccessBrush" Color="#FF2BFFB0" />
            <SolidColorBrush x:Key="SystemFillColorAttentionBrush" Color="#FF00E5FF" />

            <!-- Dialogs and flyouts -->
            <SolidColorBrush x:Key="ContentDialogBackground" Color="#F2050E1E" />
            <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="#FF00E5FF" />
            <SolidColorBrush x:Key="FlyoutPresenterBackground" Color="#F2050E1E" />
            <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#F2050E1E" />
            <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#F2050E1E" />
            <SolidColorBrush x:Key="ToolTipBackground" Color="#F2050E1E" />
            <SolidColorBrush x:Key="ToolTipBorderBrush" Color="#FF00E5FF" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Palette -->
    <Color x:Key="HudCyanColor">#FF00E5FF</Color>
    <Color x:Key="HudBlueColor">#FF2F8BFF</Color>
    <Color x:Key="HudMagentaColor">#FFFF2BD6</Color>
    <Color x:Key="HudVioletColor">#FFA371FF</Color>
    <Color x:Key="HudOrangeColor">#FFFF9A1F</Color>
    <Color x:Key="HudAmberColor">#FFFFCB47</Color>
    <Color x:Key="HudRedColor">#FFFF4D73</Color>
    <Color x:Key="HudGreenColor">#FF2BFFB0</Color>
    <Color x:Key="HudTextColor">#FFE9F8FF</Color>
    <Color x:Key="HudTextDimColor">#FF9CC3D8</Color>
    <Color x:Key="HudTextFaintColor">#FF6F93A8</Color>
    <Color x:Key="HudVoidColor">#FF030812</Color>
    <Color x:Key="HudPanelColor">#C8071226</Color>
    <Color x:Key="HudPanelElevatedColor">#D80C1A33</Color>
    <Color x:Key="HudStrokeColor">#9000E5FF</Color>
    <Color x:Key="HudStrokeMutedColor">#4020C8FF</Color>

    <SolidColorBrush x:Key="HudCyanBrush" Color="{StaticResource HudCyanColor}" />
    <SolidColorBrush x:Key="HudBlueBrush" Color="{StaticResource HudBlueColor}" />
    <SolidColorBrush x:Key="HudMagentaBrush" Color="{StaticResource HudMagentaColor}" />
    <SolidColorBrush x:Key="HudVioletBrush" Color="{StaticResource HudVioletColor}" />
    <SolidColorBrush x:Key="HudOrangeBrush" Color="{StaticResource HudOrangeColor}" />
    <SolidColorBrush x:Key="HudAmberBrush" Color="{StaticResource HudAmberColor}" />
    <SolidColorBrush x:Key="HudRedBrush" Color="{StaticResource HudRedColor}" />
    <SolidColorBrush x:Key="HudGreenBrush" Color="{StaticResource HudGreenColor}" />
    <SolidColorBrush x:Key="HudTextBrush" Color="{StaticResource HudTextColor}" />
    <SolidColorBrush x:Key="HudTextDimBrush" Color="{StaticResource HudTextDimColor}" />
    <SolidColorBrush x:Key="HudTextFaintBrush" Color="{StaticResource HudTextFaintColor}" />
    <SolidColorBrush x:Key="HudPanelBrush" Color="{StaticResource HudPanelColor}" />
    <SolidColorBrush x:Key="HudPanelElevatedBrush" Color="{StaticResource HudPanelElevatedColor}" />
    <SolidColorBrush x:Key="HudStrokeBrush" Color="{StaticResource HudStrokeColor}" />
    <SolidColorBrush x:Key="HudStrokeMutedBrush" Color="{StaticResource HudStrokeMutedColor}" />
    <SolidColorBrush x:Key="HudCyanTintBrush" Color="#2200E5FF" />
    <SolidColorBrush x:Key="HudMagentaTintBrush" Color="#22FF2BD6" />
    <SolidColorBrush x:Key="HudGreenTintBrush" Color="#222BFFB0" />
    <SolidColorBrush x:Key="HudAmberTintBrush" Color="#26FFCB47" />
    <SolidColorBrush x:Key="HudOrangeTintBrush" Color="#26FF9A1F" />
    <SolidColorBrush x:Key="HudRedTintBrush" Color="#2AFF4D73" />

    <!-- Panel edge: bright cyan at the top-left corner, fading, then a magenta accent at the opposite corner. -->
    <LinearGradientBrush x:Key="HudEdgeBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#E600E5FF" Offset="0" />
        <GradientStop Color="#5520C8FF" Offset="0.28" />
        <GradientStop Color="#2A2F8BFF" Offset="0.62" />
        <GradientStop Color="#99FF2BD6" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="HudEdgeAlertBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFF4D73" Offset="0" />
        <GradientStop Color="#55FF4D73" Offset="0.4" />
        <GradientStop Color="#CCFF9A1F" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="HudPanelGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#D20B1B36" Offset="0" />
        <GradientStop Color="#C4050E20" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="HudHeaderRuleBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FF00E5FF" Offset="0" />
        <GradientStop Color="#992F8BFF" Offset="0.35" />
        <GradientStop Color="#55FF2BD6" Offset="0.7" />
        <GradientStop Color="#00FF2BD6" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="HudAccentGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FF00E5FF" Offset="0" />
        <GradientStop Color="#FF2F8BFF" Offset="0.55" />
        <GradientStop Color="#FFA371FF" Offset="1" />
    </LinearGradientBrush>

    <!-- Legacy keys used across existing pages, now pointing at the HUD palette. -->
    <Color x:Key="DownpourAccentColor">#FF00E5FF</Color>
    <SolidColorBrush x:Key="DownpourAccentBrush" Color="#FF00E5FF" />
    <SolidColorBrush x:Key="DownpourSurfaceBrush" Color="#C8071226" />
    <SolidColorBrush x:Key="DownpourSurfaceElevatedBrush" Color="#D80C1A33" />
    <LinearGradientBrush x:Key="DownpourStrokeBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#E600E5FF" Offset="0" />
        <GradientStop Color="#5520C8FF" Offset="0.28" />
        <GradientStop Color="#2A2F8BFF" Offset="0.62" />
        <GradientStop Color="#99FF2BD6" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="DownpourMutedStrokeBrush" Color="#4020C8FF" />

    <!-- Shape and type -->
    <CornerRadius x:Key="ControlCornerRadius">2</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">4</CornerRadius>
    <FontFamily x:Key="HudFontFamily">Bahnschrift</FontFamily>
    <FontFamily x:Key="ContentControlThemeFontFamily">Bahnschrift</FontFamily>


    <!-- HUD building blocks for pages -->
    <LinearGradientBrush x:Key="HudMeterBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FF00E5FF" Offset="0" />
        <GradientStop Color="#FF2F8BFF" Offset="0.5" />
        <GradientStop Color="#FFFF2BD6" Offset="1" />
    </LinearGradientBrush>
    <Style x:Key="HudMeterStyle" TargetType="ProgressBar">
        <Setter Property="Height" Value="8" />
        <Setter Property="MinHeight" Value="8" />
        <Setter Property="Foreground" Value="{StaticResource HudMeterBrush}" />
        <Setter Property="Background" Value="#2A20C8FF" />
        <Setter Property="BorderBrush" Value="#5000E5FF" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style TargetType="ProgressBar" BasedOn="{StaticResource HudMeterStyle}" />

    <Style x:Key="HudCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource HudPanelGradientBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource HudEdgeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Padding" Value="18,16" />
    </Style>
    <Style x:Key="HudAlertCardStyle" TargetType="Border" BasedOn="{StaticResource HudCardStyle}">
        <Setter Property="BorderBrush" Value="{StaticResource HudEdgeAlertBrush}" />
    </Style>
    <Style x:Key="HudChipStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource HudCyanTintBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource HudStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="HudPageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource HudFontFamily}" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="60" />
        <Setter Property="Foreground" Value="{StaticResource HudTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="HudEyebrowStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource HudFontFamily}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="240" />
        <Setter Property="Foreground" Value="{StaticResource HudCyanBrush}" />
    </Style>
    <Style x:Key="HudSectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource HudFontFamily}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="120" />
        <Setter Property="Foreground" Value="{StaticResource HudTextBrush}" />
    </Style>
    <Style x:Key="HudMetricStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource HudFontFamily}" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource HudCyanBrush}" />
    </Style>
    <Style x:Key="HudCaptionStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource HudFontFamily}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="CharacterSpacing" Value="160" />
        <Setter Property="Foreground" Value="{StaticResource HudTextDimBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
</ResourceDictionary>
