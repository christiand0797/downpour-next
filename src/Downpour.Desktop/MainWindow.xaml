<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Downpour_Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Downpour"
    mc:Ignorable="d">
    <Window.SystemBackdrop><MicaBackdrop /></Window.SystemBackdrop>
    <Grid x:Name="ShellRoot" Background="#FF050B16" SizeChanged="ShellRoot_SizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Image Grid.RowSpan="2" Source="ms-appx:///Assets/StormBackdrop.png" Stretch="UniformToFill" Opacity="0.86" IsHitTestVisible="False" />
        <Border Grid.RowSpan="2" Background="#67040A16" IsHitTestVisible="False" />
        <Image Grid.RowSpan="2" Source="ms-appx:///Assets/CrescentMoon.png" Width="210" Height="200"
               HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,48,260,0" Opacity="0.9"
               Stretch="Uniform" IsHitTestVisible="False" />
        <Canvas x:Name="StormCanvas" Grid.RowSpan="2" IsHitTestVisible="False" />
        <Border x:Name="LightningFlash" Grid.RowSpan="2" Background="#FFD8F5FF" Opacity="0" IsHitTestVisible="False" />
        <TitleBar x:Name="AppTitleBar" Title="Downpour" BackRequested="TitleBar_BackRequested"
                  IsBackButtonVisible="{x:Bind NavFrame.CanGoBack, Mode=OneWay}"
                  IsPaneToggleButtonVisible="True" PaneToggleRequested="TitleBar_PaneToggleRequested">
            <TitleBar.IconSource><ImageIconSource ImageSource="Assets/AppIcon.ico" /></TitleBar.IconSource>
        </TitleBar>
        <NavigationView x:Name="NavView" Grid.Row="1" IsBackButtonVisible="Collapsed"
                        IsPaneToggleButtonVisible="False" IsSettingsVisible="False"
                        PaneDisplayMode="Left" OpenPaneLength="252" SelectionChanged="NavView_SelectionChanged"
                        SizeChanged="NavView_SizeChanged" Background="Transparent">
            <NavigationView.PaneHeader>
                <Border x:Name="NavigationIdentity" Margin="12,6,12,16" Padding="14,13" CornerRadius="12"
                        BorderThickness="1" BorderBrush="#504BCADB" HorizontalAlignment="Stretch">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#D0122937" Offset="0" />
                            <GradientStop Color="#E016112C" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel Spacing="7">
                        <TextBlock Text="DOWNPOUR" FontSize="17" FontWeight="SemiBold" CharacterSpacing="180" Foreground="{ThemeResource HudTextBrush}" />
                        <TextBlock Text="SECURITY OPERATIONS" FontSize="10" CharacterSpacing="100" Foreground="{ThemeResource HudTextDimBrush}" />
                        <Border Height="2" Margin="0,3,0,0" CornerRadius="1" IsHitTestVisible="False">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#B000E5FF" Offset="0" />
                                    <GradientStop Color="#909F77FD" Offset="0.6" />
                                    <GradientStop Color="#10FF2BD6" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </StackPanel>
                </Border>
            </NavigationView.PaneHeader>
            <NavigationView.MenuItems />
            <Frame x:Name="NavFrame" Background="Transparent" />
        </NavigationView>
    </Grid>
</Window>
