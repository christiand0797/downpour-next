<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="Downpour_Desktop.Pages.DevicesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:Downpour_Desktop.Pages"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="28,24,28,36" Spacing="16">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Spacing="5">
                    <TextBlock Text="MONITORING  /  DEVICES &amp; DRIVERS" Style="{StaticResource HudEyebrowStyle}" />
                    <TextBlock Text="Devices and drivers" Style="{StaticResource HudPageTitleStyle}" />
                    <TextBlock Text="Every device Windows knows about, whether its driver works, how old and who signed it, which devices are missing a driver, and which driver updates Windows Update has for this PC." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                    <Button x:Name="SearchButton" Content="Search for driver updates" Click="Search_Click" Style="{StaticResource AccentButtonStyle}" ToolTipService.ToolTip="Ask Windows Update which driver updates exist for this PC. Read-only: nothing is downloaded or installed." />
                    <Button Content="Device Manager" Click="DeviceManager_Click" ToolTipService.ToolTip="Open Windows Device Manager to update, roll back, uninstall or reinstall a driver." />
                    <Button Content="Optional updates" Click="OptionalUpdates_Click" ToolTipService.ToolTip="Open Windows Update's optional driver updates to install them." />
                    <Button Content="Refresh" Click="Refresh_Click" />
                </StackPanel>
            </Grid>

            <Border Style="{StaticResource HudCardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <FontIcon x:Name="SummaryIcon" Glyph="&#xE772;" FontSize="30" Foreground="{StaticResource HudCyanBrush}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Spacing="3">
                        <TextBlock x:Name="SummaryHeadline" Text="Reading devices…" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock x:Name="SummaryDetail" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid x:Name="ChartRow" />

            <TextBlock Text="Where your drivers come from" Style="{StaticResource HudSectionTitleStyle}" />
            <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                       Text="Windows Update carries many drivers, but graphics, chipset, audio, network and laptop-specific drivers often come only from the chip maker or your PC or motherboard maker. These are their official pages; Downpour never downloads or runs installers itself." />
            <Border Style="{StaticResource HudCardStyle}">
                <StackPanel x:Name="SourcesPanel" Spacing="8" />
            </Border>

            <TextBlock Text="Needs attention" Style="{StaticResource HudSectionTitleStyle}" />
            <TextBlock x:Name="ProblemsEmpty" Text="Every connected device has a working driver." Foreground="{StaticResource HudGreenBrush}" Visibility="Collapsed" />
            <StackPanel x:Name="ProblemsPanel" Spacing="8" />

            <TextBlock Text="Driver updates from Windows Update" Style="{StaticResource HudSectionTitleStyle}" />
            <TextBlock x:Name="UpdatesStatus" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            <StackPanel x:Name="UpdatesPanel" Spacing="8" />

            <TextBlock Text="Check with the maker" Style="{StaticResource HudSectionTitleStyle}" />
            <TextBlock x:Name="ChecksStatus" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            <StackPanel x:Name="ChecksPanel" Spacing="8" />

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions>
                <TextBlock Text="All devices" Style="{StaticResource HudSectionTitleStyle}" VerticalAlignment="Center" />
                <AutoSuggestBox x:Name="SearchBox" Grid.Column="1" PlaceholderText="Filter by name, class, maker, driver provider or version" TextChanged="Filter_Changed" />
                <ComboBox x:Name="ClassFilter" Grid.Column="2" HorizontalAlignment="Stretch" SelectionChanged="ClassFilter_Changed" PlaceholderText="All classes" />
            </Grid>
            <TextBlock x:Name="ListCount" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <ListView x:Name="DeviceList" ItemsSource="{x:Bind Rows}" SelectionMode="None" IsItemClickEnabled="False" MaxHeight="640" Background="{StaticResource HudPanelBrush}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:PnpDeviceRow">
                        <Grid Padding="10,8" ColumnSpacing="14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="2.2*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="1.8*" /><ColumnDefinition Width="1.4*" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="1">
                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind Manufacturer}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{x:Bind Class}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2" Text="{x:Bind State}" FontSize="12" VerticalAlignment="Center" Foreground="{x:Bind StateBrush}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="3" Text="{x:Bind Driver}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="4" Text="{x:Bind Signer}" FontSize="11" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Border Padding="14" CornerRadius="10" Background="{StaticResource HudPanelBrush}" BorderBrush="{StaticResource HudEdgeBrush}" BorderThickness="1">
                <StackPanel Spacing="6">
                    <TextBlock Text="Updating, reinstalling and removing drivers" FontWeight="SemiBold" Foreground="{StaticResource HudAmberBrush}" />
                    <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                               Text="Driver changes need administrator rights and can leave a PC without a working network or display if they go wrong, so they run in Windows' own tools: Optional updates installs Windows Update drivers; Device Manager can update, roll back, uninstall and reinstall a driver. One-click changes inside Downpour will come with the elevated driver broker, which backs up the current driver and can roll it back automatically." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
