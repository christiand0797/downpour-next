<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="Downpour_Desktop.Pages.ForensicsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="24,20,24,30" Spacing="16">
            <!-- Header -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Foreground="{StaticResource HudCyanBrush}" Text="DOWNPOUR  /  FORENSICS  /  EVIDENCE COLLECTOR &amp; LEGAL REPORT GENERATOR" />
                    <TextBlock Style="{StaticResource TitleTextBlockStyle}" FontSize="30" Text="Forensic Evidence Collector &amp; Legal Reports" />
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Collect, cryptographically sign, and package host security compromise evidence for law enforcement (Police Report, FBI IC3, CERT). Strictly read-only." TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button x:Name="CollectButton" Content="Collect Evidence" Style="{StaticResource AccentButtonStyle}" Click="Collect_Click" />
                    <Button x:Name="ExportHtmlButton" Content="Export Legal Report" Click="ExportHtml_Click" />
                    <Button x:Name="ExportJsonButton" Content="Export JSON Bundle" Click="ExportJson_Click" />
                    <Button x:Name="OpenIc3Button" Content="Open FBI IC3" Click="OpenIc3_Click" />
                </StackPanel>
            </Grid>

            <!-- Overview Banner -->
            <Border Padding="16,14" CornerRadius="10" Background="{StaticResource HudPanelBrush}" BorderBrush="{StaticResource HudEdgeBrush}" BorderThickness="1">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE8A5;" FontSize="28" Foreground="{StaticResource HudCyanBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                        <TextBlock x:Name="StatusHeadline" FontWeight="SemiBold" FontSize="14" Text="Forensic Evidence Collection Ready" />
                        <TextBlock x:Name="StatusDetail" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Collects live chain of custody, security alerts, event logs, persistence entries, blocked firewall connections, and network endpoints with SHA-256 seal." TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                        <Border CornerRadius="8" Padding="12,8" Background="{StaticResource HudCyanTintBrush}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock x:Name="TotalEvidenceText" Text="—" FontSize="20" FontWeight="Bold" Foreground="{StaticResource HudCyanBrush}" HorizontalAlignment="Center" />
                                <TextBlock Text="Total Evidence" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Border CornerRadius="8" Padding="12,8" Background="{StaticResource HudCyanTintBrush}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock x:Name="CriticalHighText" Text="—" FontSize="20" FontWeight="Bold" Foreground="{StaticResource HudRedBrush}" HorizontalAlignment="Center" />
                                <TextBlock Text="Critical / High" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Border CornerRadius="8" Padding="12,8" Background="{StaticResource HudCyanTintBrush}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock x:Name="AttackerIpsText" Text="—" FontSize="20" FontWeight="Bold" Foreground="{StaticResource HudCyanBrush}" HorizontalAlignment="Center" />
                                <TextBlock Text="Attacker IPs" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Policy & Read-Only Notice -->
            <Border Padding="12,9" CornerRadius="8" Background="{StaticResource HudCyanTintBrush}" BorderBrush="{StaticResource HudEdgeBrush}" BorderThickness="1">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE72E;" FontSize="16" Foreground="{StaticResource HudCyanBrush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Read-Only Evidence Preservation: Operations are purely observational. No processes killed, no files altered, no network probe packets transmitted. Digital chain-of-custody sealed with SHA-256." VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Chain of Custody & Hash Card -->
            <Border x:Name="ChainOfCustodyCard" Visibility="Collapsed" Padding="14,12" CornerRadius="8" Background="#121622" BorderBrush="{StaticResource HudEdgeBrush}" BorderThickness="1">
                <StackPanel Spacing="6">
                    <TextBlock Text="Digital Chain of Custody &amp; Integrity Seal" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource HudCyanBrush}" />
                    <Grid ColumnSpacing="12" RowSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Hostname:" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="CocHostnameText" FontSize="11" FontWeight="SemiBold" />

                        <TextBlock Grid.Row="0" Grid.Column="2" Text="OS Platform:" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Row="0" Grid.Column="3" x:Name="CocOsText" FontSize="11" FontWeight="SemiBold" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Local IP(s):" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="CocIpText" FontSize="11" TextWrapping="Wrap" />

                        <TextBlock Grid.Row="1" Grid.Column="2" Text="MAC Address(es):" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Row="1" Grid.Column="3" x:Name="CocMacText" FontSize="11" TextWrapping="Wrap" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="SHA-256 Seal:" FontSize="11" Foreground="{StaticResource HudBlueBrush}" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" x:Name="CocSha256Text" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource HudBlueBrush}" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Filter & Search Controls -->
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="150" />
                </Grid.ColumnDefinitions>
                <AutoSuggestBox x:Name="SearchBox" PlaceholderText="Search evidence by title, technique, or details..." TextChanged="SearchBox_TextChanged" />
                <ComboBox Grid.Column="1" x:Name="CategoryFilter" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="Filter_SelectionChanged">
                    <x:String>All Categories</x:String>
                    <x:String>Security Alert</x:String>
                    <x:String>Account Compromise</x:String>
                    <x:String>Defender Tampering</x:String>
                    <x:String>RDP Session</x:String>
                    <x:String>Firewall Event</x:String>
                    <x:String>Persistence &amp; Autostart</x:String>
                    <x:String>Active Remote Endpoint</x:String>
                    <x:String>Kernel Driver Anomaly</x:String>
                </ComboBox>
                <ComboBox Grid.Column="2" x:Name="SeverityFilter" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="Filter_SelectionChanged">
                    <x:String>All Severities</x:String>
                    <x:String>CRITICAL</x:String>
                    <x:String>HIGH</x:String>
                    <x:String>MEDIUM</x:String>
                    <x:String>LOW</x:String>
                    <x:String>INFORMATIONAL</x:String>
                </ComboBox>
            </Grid>

            <!-- Evidence Catalog ListView -->
            <ListView x:Name="EvidenceList" ItemsSource="{x:Bind ArtifactRows}" SelectionMode="None" IsItemClickEnabled="False" Background="{StaticResource DownpourSurfaceBrush}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="12,9" ColumnSpacing="12" Visibility="{Binding Visibility}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="140" />
                            </Grid.ColumnDefinitions>

                            <!-- Severity Badge -->
                            <Border CornerRadius="6" Padding="6,3" Background="{Binding SeverityBackground}" VerticalAlignment="Center" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding Severity}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding SeverityForeground}" HorizontalAlignment="Center" />
                            </Border>

                            <!-- Category & MITRE Technique -->
                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Category}" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding TechniqueDisplay}" FontSize="10" Foreground="{StaticResource HudBlueBrush}" FontFamily="Consolas" />
                            </StackPanel>

                            <!-- Title & Detail -->
                            <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding RawReferenceDisplay}" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontFamily="Consolas" />
                            </StackPanel>

                            <!-- Timestamp -->
                            <TextBlock Grid.Column="3" Text="{Binding TimestampDisplay}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
                <ListView.Footer>
                    <TextBlock x:Name="EmptyState" Text="Click 'Collect Evidence' to inspect local security signals and assemble a chain of custody package." Padding="14" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                </ListView.Footer>
            </ListView>

            <!-- Law Enforcement Filing Guidance Card -->
            <Border Padding="14,12" CornerRadius="8" Background="{StaticResource HudPanelBrush}" BorderBrush="{StaticResource HudStrokeMutedBrush}" BorderThickness="1">
                <StackPanel Spacing="6">
                    <TextBlock Text="Law Enforcement &amp; Incident Submission Guidance" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource HudBlueBrush}" />
                    <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="• FBI Internet Crime Complaint Center (IC3): File online at https://www.ic3.gov with the exported HTML report and raw JSON bundle attached." TextWrapping="Wrap" />
                    <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="• Local Police Department / Detective Bureau: Provide a printed copy of the HTML report accompanied by a write-protected USB drive containing the raw JSON evidence package." TextWrapping="Wrap" />
                    <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="• Chain of Custody: The evidence package is sealed with a cryptographic SHA-256 digest ensuring digital authenticity and non-repudiation." TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
