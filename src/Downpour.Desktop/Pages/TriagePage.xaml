<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="Downpour_Desktop.Pages.TriagePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">
    <Grid Padding="24,20,24,30" RowSpacing="14">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock x:Name="Breadcrumb" Style="{StaticResource SubtitleTextBlockStyle}" Foreground="{StaticResource HudCyanBrush}" />
                <TextBlock x:Name="PageTitle" Style="{StaticResource TitleTextBlockStyle}" FontSize="30" />
                <TextBlock x:Name="PageDescription" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button x:Name="ExportCaseButton" Click="ExportCase_Click" Style="{StaticResource AccentButtonStyle}" ToolTipService.ToolTip="Save every finding with its evidence so a reviewer or AI agent of your choice can double-check before you act">
                    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xEDE1;" FontSize="14" /><TextBlock Text="Export case file" /></StackPanel>
                </Button>
                <Button Content="Refresh" Click="Refresh_Click" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Padding="14,11" CornerRadius="10" Background="{StaticResource HudPanelBrush}" BorderBrush="{StaticResource HudEdgeBrush}" BorderThickness="1">
            <StackPanel Spacing="3">
                <TextBlock x:Name="StatusHeadline" FontWeight="SemiBold" Text="Loading" />
                <TextBlock x:Name="StatusDetail" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" ColumnSpacing="10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <AutoSuggestBox x:Name="SearchBox" PlaceholderText="Filter by title, source, or technique" TextChanged="Filter_Changed" />
            <ComboBox Grid.Column="1" x:Name="SourceFilter" SelectedIndex="0" SelectionChanged="Filter_Changed" MinWidth="150">
                <x:String>All sources</x:String><x:String>Windows events</x:String><x:String>Hardening</x:String><x:String>Firewall</x:String><x:String>Persistence</x:String>
            </ComboBox>
            <CheckBox Grid.Column="2" x:Name="ShowDismissed" Content="Show dismissed" Checked="Filter_Changed" Unchecked="Filter_Changed" />
        </Grid>

        <ListView x:Name="TriageList" Grid.Row="3" ItemsSource="{x:Bind Items}" SelectionMode="None" Background="{StaticResource DownpourSurfaceBrush}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="12,9" ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="78" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="{Binding Severity}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding SeverityBrush}" />
                            <TextBlock Text="{Binding StateLabel}" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding IndicatorText}" Visibility="{Binding IndicatorVisibility}" FontSize="11" FontFamily="Consolas" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Top">
                            <Button Content="Verify" ToolTipService.ToolTip="Confirm this is a real threat and move it to Threats" Tag="{Binding AlertId}" Visibility="{Binding VerifyVisibility}" Click="Verify_Click" Padding="7,5" FontSize="10" />
                            <Button Content="Unverify" ToolTipService.ToolTip="Move this item back to Possible Threats" Tag="{Binding AlertId}" Visibility="{Binding UnverifyVisibility}" Click="Unverify_Click" Padding="7,5" FontSize="10" />
                            <Button Content="Mark FP" ToolTipService.ToolTip="Confirm a false positive; this exact finding is suppressed after three confirmations" Tag="{Binding AlertId}" IsEnabled="{Binding CanTriage}" Click="FalsePositive_Click" Padding="7,5" FontSize="10" />
                            <Button Content="Dismiss" ToolTipService.ToolTip="Dismiss this item only" Tag="{Binding AlertId}" IsEnabled="{Binding CanTriage}" Click="Dismiss_Click" Padding="7,5" FontSize="10" />
                            <Button Content="Reopen" ToolTipService.ToolTip="Reopen a dismissed item" Tag="{Binding AlertId}" Visibility="{Binding ReopenVisibility}" Click="Reopen_Click" Padding="7,5" FontSize="10" />
                            <Button Content="Quarantine file…" ToolTipService.ToolTip="Review and quarantine the file named in this finding" Tag="{Binding AlertId}" Visibility="{Binding QuarantineVisibility}" Click="QuarantineIndicator_Click" Padding="7,5" FontSize="10" />
                            <Button Content="Block IP…" ToolTipService.ToolTip="Review and block this remote IP in Windows Firewall for 24 hours" Tag="{Binding AlertId}" Visibility="{Binding BlockIpVisibility}" Click="BlockIndicator_Click" Padding="7,5" FontSize="10" />
                            <Button Content="Copy" ToolTipService.ToolTip="Copy details to the clipboard" Tag="{Binding AlertId}" Click="Copy_Click" Padding="7,5" FontSize="10" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
            <ListView.Footer>
                <TextBlock x:Name="EmptyState" Padding="14" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
            </ListView.Footer>
        </ListView>

        <TextBlock Grid.Row="4" x:Name="Footnote" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
    </Grid>
</Page>
