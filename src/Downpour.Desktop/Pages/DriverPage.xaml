<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="Downpour_Desktop.Pages.DriverPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">
    <Grid Padding="24,20,24,30" RowSpacing="14">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Foreground="{StaticResource HudCyanBrush}" Text="DEVICE MONITORING  /  READ ONLY" />
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" FontSize="30" Text="Drivers" />
                <TextBlock x:Name="InventoryStatus" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Connecting to the local sensor service…" TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="1" Content="Refresh" Click="Refresh_Click" VerticalAlignment="Center" />
        </Grid>
        <Grid x:Name="ChartRow" Grid.Row="1" />
        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <AutoSuggestBox x:Name="DriverSearch" PlaceholderText="Filter loaded kernel drivers by name or path" TextChanged="DriverSearch_TextChanged" />
            <TextBlock x:Name="DriverCount" Grid.Column="1" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>
        <Border Grid.Row="3" Padding="13,10" CornerRadius="9" Background="#B8161712" BorderBrush="#78D3A14D" BorderThickness="1">
            <StackPanel Spacing="3">
                <TextBlock FontWeight="SemiBold" Text="Inventory only · no driver package changes are enabled" />
                <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="This view lists loaded kernel modules and highlights paths that deserve review. It does not verify digital signatures or decide that a driver is malicious. Install, update, reinstall, and removal workflows will require signed-package verification, a recovery path, elevation, and an audit trail." TextWrapping="Wrap" />
            </StackPanel>
        </Border>
        <Grid Grid.Row="4" RowSpacing="10">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid Padding="13,10" ColumnSpacing="12" Background="{StaticResource DownpourSurfaceElevatedBrush}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
                <TextBlock FontSize="11" FontWeight="SemiBold" CharacterSpacing="70" Text="KERNEL MODULE" />
                <TextBlock Grid.Column="1" FontSize="11" FontWeight="SemiBold" CharacterSpacing="70" Text="IMAGE PATH" />
                <TextBlock Grid.Column="2" FontSize="11" FontWeight="SemiBold" CharacterSpacing="70" Text="LOCATION REVIEW" />
            </Grid>
            <ListView x:Name="DriverList" Grid.Row="1" ItemsSource="{x:Bind Drivers}" SelectionMode="None" IsItemClickEnabled="False" Background="{StaticResource DownpourSurfaceBrush}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="13,8" ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding ImagePath}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding LocationStatus}" FontSize="11" Foreground="{Binding StatusBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
                <ListView.Footer>
                    <TextBlock Padding="13,12" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="Loaded-driver inventory is not the same as the installed Driver Store package list. Missing paths and restricted access remain unknown, not safe." TextWrapping="Wrap" />
                </ListView.Footer>
            </ListView>
        </Grid>
    </Grid>
</Page>
