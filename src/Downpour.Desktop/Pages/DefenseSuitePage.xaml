<Page
    x:Class="Downpour_Desktop.Pages.DefenseSuitePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="16" Margin="24,16,24,24">

            <!-- Header Section -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="Executive Defense Suite" FontSize="24" FontWeight="SemiBold" Foreground="#F3F4F6" />
                        <Border x:Name="StatusBadge" CornerRadius="4" Padding="8,2" VerticalAlignment="Center" Background="#064E3B" BorderBrush="#059669" BorderThickness="1">
                            <TextBlock x:Name="StatusBadgeText" Text="OPTIMAL POSTURE" FontSize="11" FontWeight="Bold" Foreground="#34D399" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Unified defense posture aggregation, MITRE ATT&amp;CK watcher diagnostics, and attack surface exposure assessment."
                               FontSize="13" Foreground="#9CA3AF" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button x:Name="EvaluateButton" Click="EvaluateButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE72C;" FontSize="13" />
                            <TextBlock Text="Evaluate Posture" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ExportReportButton" Click="ExportReportButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xEDE1;" FontSize="13" />
                            <TextBlock Text="Export Posture Report" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Info Bar for Notifications -->
            <InfoBar x:Name="NotificationInfoBar" IsOpen="False" Severity="Informational" Margin="0,0,0,4" />

            <!-- Metrics Overview Cards -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8" Padding="14">
                    <StackPanel Spacing="4">
                        <TextBlock Text="DEFENSE POSTURE SCORE" FontSize="11" FontWeight="Bold" Foreground="#9CA3AF" />
                        <TextBlock x:Name="MetricDefenseScore" Text="100/100" FontSize="22" FontWeight="SemiBold" Foreground="#34D399" />
                        <TextBlock Text="Aggregated system resilience" FontSize="12" Foreground="#6B7280" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8" Padding="14">
                    <StackPanel Spacing="4">
                        <TextBlock Text="ATTACK SURFACE EXPOSURE" FontSize="11" FontWeight="Bold" Foreground="#9CA3AF" />
                        <TextBlock x:Name="MetricAttackSurface" Text="0%" FontSize="22" FontWeight="SemiBold" Foreground="#38BDF8" />
                        <TextBlock Text="Calculated exposure penalty" FontSize="12" Foreground="#6B7280" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8" Padding="14">
                    <StackPanel Spacing="4">
                        <TextBlock Text="ACTIVE DEFENSE WATCHERS" FontSize="11" FontWeight="Bold" Foreground="#9CA3AF" />
                        <TextBlock x:Name="MetricActiveWatchers" Text="8" FontSize="22" FontWeight="SemiBold" Foreground="#A78BFA" />
                        <TextBlock Text="Continuous posture verifiers" FontSize="12" Foreground="#6B7280" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8" Padding="14">
                    <StackPanel Spacing="4">
                        <TextBlock Text="FLAGGED EXPOSURES" FontSize="11" FontWeight="Bold" Foreground="#9CA3AF" />
                        <TextBlock x:Name="MetricFlaggedExposures" Text="0" FontSize="22" FontWeight="SemiBold" Foreground="#34D399" />
                        <TextBlock Text="Watchers requiring attention" FontSize="12" Foreground="#6B7280" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Core Defense Pillars Section -->
            <Border Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72E;" FontSize="16" Foreground="#38BDF8" VerticalAlignment="Center" />
                        <TextBlock Text="Core Defense Pillars" FontSize="15" FontWeight="SemiBold" Foreground="#F3F4F6" />
                        <TextBlock Text="— Integrated security subsystems" FontSize="12" Foreground="#6B7280" VerticalAlignment="Center" />
                    </StackPanel>

                    <Grid ColumnSpacing="12" RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Pillar 1: Project AEGIS -->
                        <Border Grid.Row="0" Grid.Column="0" Background="#1F2937" BorderBrush="#374151" BorderThickness="1" CornerRadius="6" Padding="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="Project AEGIS" FontWeight="SemiBold" Foreground="#F3F4F6" FontSize="13" />
                                        <Border Background="#064E3B" CornerRadius="3" Padding="6,1" VerticalAlignment="Center">
                                            <TextBlock Text="ACTIVE 95%" FontSize="10" FontWeight="Bold" Foreground="#34D399" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="Context-aware NLP phishing, social engineering, and QR credential lure analysis."
                                               FontSize="11" Foreground="#9CA3AF" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0" Click="OpenAegis_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon Glyph="&#xE72E;" FontSize="11" />
                                        <TextBlock Text="Open" FontSize="11" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Pillar 2: Ransomware Defense -->
                        <Border Grid.Row="0" Grid.Column="1" Background="#1F2937" BorderBrush="#374151" BorderThickness="1" CornerRadius="6" Padding="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="Ransomware Defense" FontWeight="SemiBold" Foreground="#F3F4F6" FontSize="13" />
                                        <Border Background="#064E3B" CornerRadius="3" Padding="6,1" VerticalAlignment="Center">
                                            <TextBlock Text="PROTECTED 92%" FontSize="10" FontWeight="Bold" Foreground="#34D399" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="Canary honeypot tripwires, VSS shadow-copy resiliency, and Shannon entropy monitoring."
                                               FontSize="11" Foreground="#9CA3AF" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0" Click="OpenRansomware_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon Glyph="&#xE8D7;" FontSize="11" />
                                        <TextBlock Text="Open" FontSize="11" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Pillar 3: Hardening & Firmware -->
                        <Border Grid.Row="1" Grid.Column="0" Background="#1F2937" BorderBrush="#374151" BorderThickness="1" CornerRadius="6" Padding="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="Hardening &amp; Firmware" FontWeight="SemiBold" Foreground="#F3F4F6" FontSize="13" />
                                        <Border Background="#064E3B" CornerRadius="3" Padding="6,1" VerticalAlignment="Center">
                                            <TextBlock Text="HARDENED 90%" FontSize="10" FontWeight="Bold" Foreground="#34D399" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="BitLocker encryption, Secure Boot state, TPM cryptographic validation, and LSA-PPL."
                                               FontSize="11" Foreground="#9CA3AF" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0" Click="OpenHardening_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon Glyph="&#xE72E;" FontSize="11" />
                                        <TextBlock Text="Open" FontSize="11" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Pillar 4: Emergency Response -->
                        <Border Grid.Row="1" Grid.Column="1" Background="#1F2937" BorderBrush="#374151" BorderThickness="1" CornerRadius="6" Padding="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="Emergency Response" FontWeight="SemiBold" Foreground="#F3F4F6" FontSize="13" />
                                        <Border Background="#064E3B" CornerRadius="3" Padding="6,1" VerticalAlignment="Center">
                                            <TextBlock Text="ARMED 100%" FontSize="10" FontWeight="Bold" Foreground="#34D399" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="One-click incident containment, volatile forensic snapshots, and guarded emergency lockdown."
                                               FontSize="11" Foreground="#9CA3AF" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0" Click="OpenEmergency_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon Glyph="&#xE7BA;" FontSize="11" />
                                        <TextBlock Text="Open" FontSize="11" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Advanced Attack Surface Watchers Section -->
            <Border Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Advanced Attack Surface Watchers" FontSize="14" FontWeight="SemiBold" Foreground="#F3F4F6" />
                            <Border x:Name="WatchersCountBadge" Background="#064E3B" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                <TextBlock x:Name="WatchersCountBadgeText" Text="8 VERIFIED" FontSize="10" FontWeight="Bold" Foreground="#34D399" />
                            </Border>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="Live MITRE ATT&amp;CK Host Posture" FontSize="11" Foreground="#6B7280" VerticalAlignment="Center" />
                    </Grid>

                    <ListView x:Name="WatcherListView" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1F2937" BorderBrush="#374151" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,2,0,2">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="3">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="#F3F4F6" FontSize="13" />
                                                <Border Background="#111827" BorderBrush="#374151" BorderThickness="1" CornerRadius="3" Padding="6,1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Category}" FontSize="10" Foreground="#9CA3AF" />
                                                </Border>
                                                <Border Background="#1E1B4B" BorderBrush="#4338CA" BorderThickness="1" CornerRadius="3" Padding="6,1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding MitreTechnique}" FontSize="10" FontWeight="Bold" Foreground="#A78BFA" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Description}" FontSize="11" Foreground="#9CA3AF" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding ObservedDetail}" FontSize="10" FontFamily="Consolas" Foreground="#38BDF8" TextWrapping="Wrap" />
                                        </StackPanel>

                                        <Border Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0"
                                                Background="{Binding StatusBadgeBackground}"
                                                BorderBrush="{Binding StatusBadgeBorder}"
                                                BorderThickness="1" CornerRadius="4" Padding="8,4">
                                            <TextBlock Text="{Binding StatusBadgeText}" FontSize="11" FontWeight="Bold" Foreground="{Binding StatusBadgeForeground}" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
