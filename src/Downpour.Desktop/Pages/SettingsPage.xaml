<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="Downpour_Desktop.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="28,24,28,36" Spacing="18" MaxWidth="1080" HorizontalAlignment="Left">
            <StackPanel Spacing="5">
                <TextBlock Text="OPERATIONS / APP PREFERENCES" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="A single place for Downpour preferences. Choices are stored locally for this Windows user." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>
            <Border Padding="18" CornerRadius="12" Background="{StaticResource DownpourSurfaceBrush}" BorderBrush="{StaticResource DownpourStrokeBrush}" BorderThickness="1">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Appearance &amp; motion" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="Adjust the animated storm background without changing telemetry or protection behavior." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Spacing="2"><TextBlock Text="Rain and sky effects" FontWeight="SemiBold" /><TextBlock Text="Show the animated rain, stars, aurora, and lightning layers." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" /></StackPanel>
                        <ToggleSwitch x:Name="RainEffectsToggle" Grid.Column="1" IsOn="True" OnContent="On" OffContent="Off" />
                    </Grid>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Spacing="2"><TextBlock Text="Reduce motion" FontWeight="SemiBold" /><TextBlock Text="Pause continuous rain, star, aurora, and lightning animation while keeping the selected scene visible." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" /></StackPanel>
                        <ToggleSwitch x:Name="ReduceMotionToggle" Grid.Column="1" IsOn="False" OnContent="On" OffContent="Off" />
                    </Grid>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Spacing="2"><TextBlock Text="Automatic storm rotation" FontWeight="SemiBold" /><TextBlock Text="Let the scene shift among drizzle, storm, thunderstorm, and hurricane. Choosing a mode on the dashboard holds it manually." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" /></StackPanel>
                        <ToggleSwitch x:Name="AutoStormToggle" Grid.Column="1" IsOn="True" OnContent="On" OffContent="Off" />
                    </Grid>
                    <TextBlock x:Name="SaveState" Text="" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </StackPanel>
            </Border>
            <Border Padding="18" CornerRadius="12" Background="{StaticResource DownpourSurfaceBrush}" BorderBrush="{StaticResource DownpourStrokeBrush}" BorderThickness="1">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Alerts &amp; notifications" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="How Downpour tells you about new high and critical alerts while it is running." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Spacing="2"><TextBlock Text="Windows notifications" FontWeight="SemiBold" /><TextBlock Text="Show a notification for new high or critical alerts. Several at once are combined into one. Clicking it opens Threats." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" /></StackPanel>
                        <ToggleSwitch x:Name="NotificationsToggle" Grid.Column="1" IsOn="True" OnContent="On" OffContent="Off" />
                    </Grid>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Spacing="2"><TextBlock Text="Minimize to the notification area" FontWeight="SemiBold" /><TextBlock Text="When the window is minimized, hide it and keep Downpour in the notification area. Closing the window still exits." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" /></StackPanel>
                        <ToggleSwitch x:Name="MinimizeToTrayToggle" Grid.Column="1" IsOn="True" OnContent="On" OffContent="Off" />
                    </Grid>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Spacing="2"><TextBlock Text="Sound alarm" FontWeight="SemiBold" /><TextBlock Text="Beep when a new critical alert arrives (off by default, as in v29)." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" /></StackPanel>
                        <ToggleSwitch x:Name="SoundAlarmToggle" Grid.Column="1" IsOn="False" OnContent="On" OffContent="Off" />
                    </Grid>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Spacing="2"><TextBlock Text="Also sound for high alerts" FontWeight="SemiBold" /><TextBlock Text="Extend the sound alarm to high-severity alerts." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" /></StackPanel>
                        <ToggleSwitch x:Name="SoundHighToggle" Grid.Column="1" IsOn="False" OnContent="On" OffContent="Off" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="Test alarm sound" Click="TestAlarm_Click" />
                        <TextBlock x:Name="NotificationState" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Padding="18" CornerRadius="12" Background="{StaticResource DownpourSurfaceBrush}" BorderBrush="{StaticResource DownpourStrokeBrush}" BorderThickness="1">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Detection data" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="What the local sensor service may read to detect threats. These settings are stored by the service." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Spacing="2"><TextBlock Text="Analyze PowerShell script blocks" FontWeight="SemiBold" /><TextBlock Text="Read PowerShell script text (Event 4104) and check it with Sigma rules and AMSI. The text is analyzed in memory only and is never saved, exported, or shown; alerts keep only the rule name." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" /></StackPanel>
                        <ToggleSwitch x:Name="ScriptBlockToggle" Grid.Column="1" IsOn="True" IsEnabled="False" OnContent="On" OffContent="Off" />
                    </Grid>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Spacing="2"><TextBlock Text="Sample documents for ransomware checks" FontWeight="SemiBold" /><TextBlock Text="The Ransomware screen reads up to 64 KB of documents in protected folders (Documents, Desktop and similar) to detect encrypted files. Only an entropy score is kept. When off, it checks file names and extensions only." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" /></StackPanel>
                        <ToggleSwitch x:Name="RansomwareSamplingToggle" Grid.Column="1" IsOn="True" OnContent="On" OffContent="Off" />
                    </Grid>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Spacing="2"><TextBlock Text="Allow quarantine actions" FontWeight="SemiBold" /><TextBlock Text="Lets the Remediation page quarantine and restore files you choose. Each action still asks for your confirmation and is recorded. When off, the service refuses every quarantine and restore request." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" /></StackPanel>
                        <ToggleSwitch x:Name="QuarantineActionsToggle" Grid.Column="1" IsOn="True" IsEnabled="False" OnContent="On" OffContent="Off" />
                    </Grid>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Spacing="2"><TextBlock Text="Allow process termination" FontWeight="SemiBold" /><TextBlock Text="Permits ending a reviewed process after its own confirmation. Protected processes remain denied. Turning this off makes the service refuse termination requests." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" /></StackPanel>
                        <ToggleSwitch x:Name="ProcessActionsToggle" Grid.Column="1" IsOn="True" IsEnabled="False" OnContent="On" OffContent="Off" />
                    </Grid>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Spacing="2"><TextBlock Text="Allow firewall actions" FontWeight="SemiBold" /><TextBlock Text="Permits confirmed, expiring IP blocks and removal of Downpour rules when Windows grants access. Automatic expiry continues when this switch is off." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" /></StackPanel>
                        <ToggleSwitch x:Name="FirewallActionsToggle" Grid.Column="1" IsOn="True" IsEnabled="False" OnContent="On" OffContent="Off" />
                    </Grid>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Spacing="2"><TextBlock Text="Allow USB actions" FontWeight="SemiBold" /><TextBlock Text="Permits confirmed blocks or restores of approved USB storage and mass-storage policy changes when Windows grants access. Input devices and hubs remain protected." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" /></StackPanel>
                        <ToggleSwitch x:Name="UsbActionsToggle" Grid.Column="1" IsOn="True" IsEnabled="False" OnContent="On" OffContent="Off" />
                    </Grid>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Spacing="2"><TextBlock Text="Allow host isolation" FontWeight="SemiBold" /><TextBlock Text="Permits a confirmed, time-limited network cut-off (5 minutes to 24 hours). A Windows scheduled task always ends it on time, even if Downpour is closed; isolation is refused if that cannot be scheduled." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" /></StackPanel>
                        <ToggleSwitch x:Name="HostIsolationToggle" Grid.Column="1" IsOn="True" IsEnabled="False" OnContent="On" OffContent="Off" />
                    </Grid>
                    <TextBlock x:Name="SensorSettingsState" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Padding="18" CornerRadius="12" Background="{StaticResource DownpourSurfaceBrush}" BorderBrush="{StaticResource DownpourStrokeBrush}" BorderThickness="1">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Threat intelligence lookups" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="Automatically check public IP addresses, file hashes, and DNS-flagged domains from open alerts with the services below, using your own API keys. Private, loopback, and local-network addresses are never sent. Keys are encrypted for your Windows account and never shown again after saving." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Spacing="2"><TextBlock Text="Automatic lookups" FontWeight="SemiBold" /><TextBlock Text="Every 5 minutes, at most 25 lookups per run, cached for 24 hours and within each service's free-tier limits. Malicious or suspicious results appear in Threats." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" /></StackPanel>
                        <ToggleSwitch x:Name="IntelLookupsToggle" Grid.Column="1" IsOn="True" IsEnabled="False" OnContent="On" OffContent="Off" />
                    </Grid>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Spacing="2"><TextBlock Text="Threat database updates" FontWeight="SemiBold" /><TextBlock Text="Downloads 45 public threat databases (LOLDrivers, abuse.ch, Spamhaus, attack-framework command servers, APT and red-team tool hashes, Pegasus and Predator spyware, ransomware, scam, phishing, cryptominer and stalkerware lists, remote-access tools, IP origin data and more) in full over HTTPS and checks this PC against them locally. No API keys, and nothing about this PC is sent. When off, saved copies are still used until they expire." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" /></StackPanel>
                        <ToggleSwitch x:Name="ThreatDatabasesToggle" Grid.Column="1" IsOn="True" IsEnabled="False" OnContent="On" OffContent="Off" />
                    </Grid>
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="140" /></Grid.ColumnDefinitions>
                        <TextBlock Text="VirusTotal" VerticalAlignment="Center" FontWeight="SemiBold" />
                        <PasswordBox x:Name="VirusTotalKeyBox" Grid.Column="1" PlaceholderText="Paste API key" MaxLength="256" />
                        <Button Grid.Column="2" Content="Save" Tag="VirusTotal" Click="SaveIntelKey_Click" />
                        <Button Grid.Column="3" Content="Remove" Tag="VirusTotal" Click="RemoveIntelKey_Click" />
                        <TextBlock x:Name="VirusTotalKeyState" Grid.Column="4" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="Not configured" />
                    </Grid>
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="140" /></Grid.ColumnDefinitions>
                        <TextBlock Text="AbuseIPDB" VerticalAlignment="Center" FontWeight="SemiBold" />
                        <PasswordBox x:Name="AbuseIpDbKeyBox" Grid.Column="1" PlaceholderText="Paste API key" MaxLength="256" />
                        <Button Grid.Column="2" Content="Save" Tag="AbuseIPDB" Click="SaveIntelKey_Click" />
                        <Button Grid.Column="3" Content="Remove" Tag="AbuseIPDB" Click="RemoveIntelKey_Click" />
                        <TextBlock x:Name="AbuseIpDbKeyState" Grid.Column="4" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="Not configured" />
                    </Grid>
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="140" /></Grid.ColumnDefinitions>
                        <TextBlock Text="GreyNoise" VerticalAlignment="Center" FontWeight="SemiBold" />
                        <PasswordBox x:Name="GreyNoiseKeyBox" Grid.Column="1" PlaceholderText="Paste API key" MaxLength="256" />
                        <Button Grid.Column="2" Content="Save" Tag="GreyNoise" Click="SaveIntelKey_Click" />
                        <Button Grid.Column="3" Content="Remove" Tag="GreyNoise" Click="RemoveIntelKey_Click" />
                        <TextBlock x:Name="GreyNoiseKeyState" Grid.Column="4" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="Not configured" />
                    </Grid>
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="IntelRunState" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        <TextBlock Text="RECENT RESULTS" FontSize="11" FontWeight="SemiBold" CharacterSpacing="85" Foreground="{StaticResource HudTextDimBrush}" />
                        <ItemsControl ItemsSource="{x:Bind IntelResults}">
                            <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" FontSize="12" TextWrapping="Wrap" /></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="OUTBOUND LOOKUPS (WHAT WAS SENT)" FontSize="11" FontWeight="SemiBold" CharacterSpacing="85" Foreground="{StaticResource HudTextDimBrush}" />
                        <ItemsControl ItemsSource="{x:Bind IntelLog}">
                            <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" FontSize="11" FontFamily="Consolas" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Padding="18" CornerRadius="12" Background="{StaticResource DownpourSurfaceBrush}" BorderBrush="{StaticResource DownpourStrokeBrush}" BorderThickness="1">
                <StackPanel Spacing="8">
                    <TextBlock Text="Privacy &amp; data" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="Preferences, sensor settings, alert metadata, action records, and configured threat-intelligence keys are stored locally for your Windows account. Saved API keys are encrypted. User-selected scans read file contents; quarantine retains the selected file locally. PowerShell script text is analyzed in memory only when its setting is on and is never stored. Clipboard contents, browser secrets, and usage analytics are not collected." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    <TextBlock Text="Threat Intelligence uses the configured feed and lookup services. Automatic enrichment can send public IP addresses, hashes, and domains as described above. Turn automatic lookups off to stop background enrichment; manually requested network checks remain explicit." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Padding="18" CornerRadius="12" Background="{StaticResource DownpourSurfaceBrush}" BorderBrush="{StaticResource DownpourStrokeBrush}" BorderThickness="1">
                <StackPanel Spacing="8">
                    <TextBlock Text="Scanning &amp; protection" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="Quarantine/restore, process termination, temporary IP firewall rules, and reversible USB controls use separate previews and confirmations. Their policy switches above permit requests; they do not perform an action themselves. Windows access checks still apply. Automatic administrator elevation, host isolation, and driver installation remain unfinished. This unsigned portable build does not provide complete v29 protection." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
