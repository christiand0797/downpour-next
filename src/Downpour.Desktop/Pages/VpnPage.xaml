<Page
    x:Class="Downpour_Desktop.Pages.VpnPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="16" Margin="24,16,24,24">

            <!-- Header Section -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="VPN &amp; Tunnel Posture" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource HudTextBrush}" />
                        <Border x:Name="VpnStatusBadge" CornerRadius="4" Padding="8,2" VerticalAlignment="Center" Background="{StaticResource HudPanelElevatedBrush}">
                            <TextBlock x:Name="VpnStatusBadgeText" Text="CHECKING" FontSize="11" FontWeight="Bold" Foreground="{StaticResource HudTextDimBrush}" />
                        </Border>
                        <Border x:Name="DnsLeakBadge" CornerRadius="4" Padding="8,2" VerticalAlignment="Center" Background="{StaticResource HudPanelElevatedBrush}">
                            <TextBlock x:Name="DnsLeakBadgeText" Text="DNS: UNCHECKED" FontSize="11" FontWeight="Bold" Foreground="{StaticResource HudTextDimBrush}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Active tunnel detection, DNS split-tunnel leak assessment, egress connectivity testing, and guarded kill-switch controls."
                               FontSize="13" Foreground="{StaticResource HudTextDimBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button x:Name="RefreshButton" Click="RefreshButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE72C;" FontSize="13" />
                            <TextBlock Text="Refresh Posture" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="TestConnectivityButton" Click="TestConnectivityButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE774;" FontSize="13" />
                            <TextBlock Text="Test Connectivity" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ImportProfileButton" Click="ImportProfileButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8E5;" FontSize="13" />
                            <TextBlock Text="Import .ovpn" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="KillSwitchButton" Click="KillSwitchButton_Click" Background="{StaticResource HudRedTintBrush}" BorderBrush="{StaticResource HudRedBrush}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE7BA;" FontSize="13" Foreground="{StaticResource HudRedBrush}" />
                            <TextBlock Text="Kill Switch" Foreground="{StaticResource HudRedBrush}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ExportReportButton" Click="ExportReportButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xEDE1;" FontSize="13" />
                            <TextBlock Text="Export Report" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Metrics Overview Cards -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource HudPanelBrush}" BorderBrush="{StaticResource HudStrokeMutedBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                    <StackPanel Spacing="4">
                        <TextBlock Text="VPN STATUS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource HudTextDimBrush}" />
                        <TextBlock x:Name="MetricVpnStatus" Text="--" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource HudCyanBrush}" />
                        <TextBlock x:Name="MetricProvider" Text="Provider: None" FontSize="12" Foreground="{StaticResource HudTextFaintBrush}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="{StaticResource HudPanelBrush}" BorderBrush="{StaticResource HudStrokeMutedBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                    <StackPanel Spacing="4">
                        <TextBlock Text="DNS LEAK AUDIT" FontSize="11" FontWeight="Bold" Foreground="{StaticResource HudTextDimBrush}" />
                        <TextBlock x:Name="MetricDnsStatus" Text="--" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource HudGreenBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="MetricDnsServerCount" Text="0 Tunnel / 0 Physical" FontSize="12" Foreground="{StaticResource HudTextFaintBrush}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="{StaticResource HudPanelBrush}" BorderBrush="{StaticResource HudStrokeMutedBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                    <StackPanel Spacing="4">
                        <TextBlock Text="NETWORK ADAPTERS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource HudTextDimBrush}" />
                        <TextBlock x:Name="MetricAdapterCount" Text="0" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource HudAmberBrush}" />
                        <TextBlock x:Name="MetricVpnAdapters" Text="0 VPN Tunnel(s)" FontSize="12" Foreground="{StaticResource HudTextFaintBrush}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Background="{StaticResource HudPanelBrush}" BorderBrush="{StaticResource HudStrokeMutedBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                    <StackPanel Spacing="4">
                        <TextBlock Text="EGRESS CONNECTIVITY" FontSize="11" FontWeight="Bold" Foreground="{StaticResource HudTextDimBrush}" />
                        <TextBlock x:Name="MetricEgressStatus" Text="Ready" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource HudVioletBrush}" />
                        <TextBlock x:Name="MetricLatencyAvg" Text="Click Test to Probe" FontSize="12" Foreground="{StaticResource HudTextFaintBrush}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- DNS Leak Inspection Card -->
            <Border Background="{StaticResource HudPanelBrush}" BorderBrush="{StaticResource HudStrokeMutedBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                <StackPanel Spacing="8">
                    <TextBlock Text="DNS Leak &amp; Split-Tunnel Analysis" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource HudTextBrush}" />
                    <TextBlock x:Name="DnsLeakDetailText" Text="Analyzing active DNS resolvers across encrypted tunnels and physical adapters..."
                               FontSize="12" Foreground="{StaticResource HudTextDimBrush}" TextWrapping="Wrap" />
                    <ItemsControl x:Name="DnsFindingsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="12" Foreground="{StaticResource HudRedBrush}" Margin="0,2,0,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Discovered Adapters Section -->
            <Border Background="{StaticResource HudPanelBrush}" BorderBrush="{StaticResource HudStrokeMutedBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                <StackPanel Spacing="10">
                    <TextBlock Text="Network Interface Posture" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource HudTextBrush}" />
                    <ListView x:Name="AdaptersList" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource HudPanelElevatedBrush}" BorderBrush="{StaticResource HudStrokeMutedBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,3,0,3">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="4">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource HudTextBrush}" FontSize="13" />
                                                <Border CornerRadius="3" Padding="6,1" VerticalAlignment="Center"
                                                        Background="{Binding BadgeBackground}">
                                                    <TextBlock Text="{Binding BadgeText}" FontSize="10" FontWeight="Bold" Foreground="{Binding BadgeForeground}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{StaticResource HudTextDimBrush}" />
                                            <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,2,0,0">
                                                <TextBlock Text="{Binding IpSummary}" FontSize="11" Foreground="{StaticResource HudBlueBrush}" />
                                                <TextBlock Text="{Binding DnsSummary}" FontSize="11" Foreground="{StaticResource HudGreenBrush}" />
                                                <TextBlock Text="{Binding GatewaySummary}" FontSize="11" Foreground="{StaticResource HudTextDimBrush}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding StatusSummary}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding StatusForeground}" />
                                            <TextBlock Text="{Binding TypeSummary}" FontSize="10" Foreground="{StaticResource HudTextFaintBrush}" HorizontalAlignment="Right" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <!-- Connectivity Test Results Section -->
            <Border x:Name="ConnectivitySection" Background="{StaticResource HudPanelBrush}" BorderBrush="{StaticResource HudStrokeMutedBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="TCP Port 443 Egress Connectivity Probes" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource HudTextBrush}" />
                        <TextBlock Text="(Matches v29 non-ICMP evasion testing)" FontSize="11" Foreground="{StaticResource HudTextFaintBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <ListView x:Name="ConnectivityList" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource HudPanelElevatedBrush}" BorderBrush="{StaticResource HudStrokeMutedBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,2,0,2">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock Text="{Binding Target}" FontWeight="SemiBold" Foreground="{StaticResource HudTextBrush}" FontSize="12" />
                                            <TextBlock Text="{Binding Details}" FontSize="11" Foreground="{StaticResource HudTextDimBrush}" />
                                        </StackPanel>
                                        <Border Grid.Column="1" CornerRadius="4" Padding="8,2" VerticalAlignment="Center"
                                                Background="{Binding StatusBackground}">
                                            <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="Bold" Foreground="{Binding StatusForeground}" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <!-- Imported / Known Profiles Section -->
            <Border Background="{StaticResource HudPanelBrush}" BorderBrush="{StaticResource HudStrokeMutedBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                <StackPanel Spacing="10">
                    <TextBlock Text="VPN Profiles &amp; Configurations" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource HudTextBrush}" />
                    <ListView x:Name="ProfilesList" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource HudPanelElevatedBrush}" BorderBrush="{StaticResource HudStrokeMutedBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,2,0,2">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource HudTextBrush}" FontSize="12" />
                                            <TextBlock Text="{Binding EndpointSummary}" FontSize="11" Foreground="{StaticResource HudBlueBrush}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Protocol}" FontSize="11" Foreground="{StaticResource HudVioletBrush}" HorizontalAlignment="Right" />
                                            <TextBlock Text="{Binding Source}" FontSize="10" Foreground="{StaticResource HudTextFaintBrush}" HorizontalAlignment="Right" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <!-- Activity Log Card -->
            <Border Background="{StaticResource HudPanelBrush}" BorderBrush="{StaticResource HudStrokeMutedBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                <StackPanel Spacing="6">
                    <TextBlock Text="VPN Activity Log" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource HudTextBrush}" />
                    <TextBox x:Name="LogTextBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                             Height="100" FontFamily="Consolas" FontSize="11" Background="#030712" Foreground="{StaticResource HudTextDimBrush}"
                             BorderBrush="{StaticResource HudStrokeMutedBrush}" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
