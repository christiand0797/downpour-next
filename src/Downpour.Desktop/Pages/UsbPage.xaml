<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="Downpour_Desktop.Pages.UsbPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="24,20,24,30" Spacing="14">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Foreground="#FF76DDF5" Text="DOWNPOUR  /  MONITORING  /  USB DEVICES" />
                    <TextBlock Style="{StaticResource TitleTextBlockStyle}" FontSize="30" Text="USB &amp; External Drive Posture" />
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Removable drive inventory, autorun detection, device history, and attack tool hardware posture. Read-only." TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" x:Name="RefreshButton" Content="Re-check" Click="Refresh_Click" VerticalAlignment="Center" />
            </Grid>

            <Border Padding="14,11" CornerRadius="10" Background="#B9081220" BorderBrush="#423EC5D8" BorderThickness="1">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE88E;" FontSize="20" Foreground="#FF60DBEE" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Spacing="3">
                        <TextBlock x:Name="StatusHeadline" FontWeight="SemiBold" Text="Checking USB device posture" />
                        <TextBlock x:Name="StatusDetail" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Readings come from DriveInfo and the USBSTOR registry hierarchy. Strictly read-only." TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Findings section -->
            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" FontSize="16" Text="Security Findings" Margin="0,8,0,0" />
            <ListView ItemsSource="{x:Bind Findings}" SelectionMode="None" IsItemClickEnabled="False" Background="{StaticResource DownpourSurfaceBrush}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="12,10" ColumnSpacing="14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="96" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Border CornerRadius="6" Padding="8,4" Background="{Binding SeverityBackground}" VerticalAlignment="Top">
                                <TextBlock Text="{Binding Severity}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding SeverityForeground}" HorizontalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="3">
                                <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Indicator}" FontFamily="Consolas" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding Technique}" FontFamily="Consolas" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Top" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
                <ListView.Footer>
                    <TextBlock x:Name="EmptyFindingsState" Padding="14" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="No USB security findings detected." TextWrapping="Wrap" />
                </ListView.Footer>
            </ListView>

            <!-- Connected devices section -->
            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" FontSize="16" Text="Connected Removable Drives" Margin="0,8,0,0" />
            <ListView ItemsSource="{x:Bind ConnectedDevices}" SelectionMode="None" IsItemClickEnabled="False" Background="{StaticResource DownpourSurfaceBrush}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="12,10" ColumnSpacing="14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="{Binding DriveLetter}" FontWeight="Bold" FontSize="16" />
                                <TextBlock Text="{Binding FileSystem}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="3">
                                <TextBlock Text="{Binding VolumeLabel}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding StorageInfo}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center">
                                <Border CornerRadius="4" Padding="6,2" Background="{Binding AutorunBackground}" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding AutorunLabel}" FontSize="10" FontWeight="SemiBold" Foreground="{Binding AutorunForeground}" />
                                </Border>
                                <Border CornerRadius="4" Padding="6,2" Background="{Binding SuspiciousBackground}" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding SuspiciousLabel}" FontSize="10" FontWeight="SemiBold" Foreground="{Binding SuspiciousForeground}" />
                                </Border>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
                <ListView.Footer>
                    <TextBlock x:Name="EmptyDevicesState" Padding="14" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="No removable storage devices currently mounted." TextWrapping="Wrap" />
                </ListView.Footer>
            </ListView>

            <!-- Device history section -->
            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" FontSize="16" Text="USB Device History (Registry)" Margin="0,8,0,0" />
            <ListView ItemsSource="{x:Bind History}" SelectionMode="None" IsItemClickEnabled="False" MaxHeight="320" Background="{StaticResource DownpourSurfaceBrush}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="12,8" ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="{Binding FriendlyName}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding DeviceDetails}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding SerialNumber}" FontFamily="Consolas" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
                <ListView.Footer>
                    <TextBlock x:Name="EmptyHistoryState" Padding="14" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="No USB device history found." TextWrapping="Wrap" />
                </ListView.Footer>
            </ListView>

            <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="Read-only posture monitoring. Drive blocking, autorun neutralizing/deletion, and write restrictions are disabled by default and require the audited action broker." TextWrapping="Wrap" Margin="0,8,0,0" />
        </StackPanel>
    </ScrollViewer>
</Page>
