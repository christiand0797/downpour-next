<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="Downpour_Desktop.Pages.ScannerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="28,24,28,36" Spacing="18" MaxWidth="1120" HorizontalAlignment="Left">
            <StackPanel Spacing="5">
                <TextBlock Text="ANALYSIS  /  STATIC FILE INSPECTION" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock Text="File Inspector" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="Choose one local EXE, DLL, or SYS file to calculate its SHA-256 and inspect bounded PE header metadata. The file is read as data and never executed or uploaded." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>
            <Border Padding="14" CornerRadius="10" Background="#A80B1524" BorderBrush="#3D46C5D8" BorderThickness="1">
                <StackPanel Spacing="6">
                    <TextBlock Text="Metadata triage · no malware verdict" FontWeight="SemiBold" Foreground="#FFFFC76A" />
                    <TextBlock Text="A SHA-256 hash, PE structure, or embedded certificate table does not establish that a file is safe or malicious. Certificate trust and reputation lookups are not performed. Maximum file size: 256 MiB." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button x:Name="ChooseFileButton" Content="Choose a file" Click="ChooseFile_Click" />
                <ProgressRing x:Name="InspectionProgress" Width="22" Height="22" IsActive="False" VerticalAlignment="Center" />
                <TextBlock x:Name="InspectionStatus" Text="No file selected." VerticalAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
            <Border x:Name="ResultCard" Visibility="Collapsed" Padding="18" CornerRadius="12" Background="#C808111E" BorderBrush="#5738B9D1" BorderThickness="1">
                <StackPanel Spacing="13">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="FILE" FontSize="11" FontWeight="SemiBold" CharacterSpacing="100" Foreground="#FF91AFC2" />
                        <TextBlock x:Name="FileNameText" Grid.Column="1" TextWrapping="Wrap" FontWeight="SemiBold" />
                    </Grid>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="SIZE" FontSize="11" FontWeight="SemiBold" CharacterSpacing="100" Foreground="#FF91AFC2" />
                        <TextBlock x:Name="FileSizeText" Grid.Column="1" />
                    </Grid>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="SHA-256" FontSize="11" FontWeight="SemiBold" CharacterSpacing="60" Foreground="#FF91AFC2" />
                        <TextBlock x:Name="HashText" Grid.Column="1" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    </Grid>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="FORMAT" FontSize="11" FontWeight="SemiBold" CharacterSpacing="100" Foreground="#FF91AFC2" />
                        <TextBlock x:Name="FormatText" Grid.Column="1" TextWrapping="Wrap" />
                    </Grid>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="PE DETAILS" FontSize="11" FontWeight="SemiBold" CharacterSpacing="55" Foreground="#FF91AFC2" />
                        <TextBlock x:Name="PeDetailsText" Grid.Column="1" TextWrapping="Wrap" />
                    </Grid>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="CERTIFICATE TABLE" FontSize="11" FontWeight="SemiBold" CharacterSpacing="45" Foreground="#FF91AFC2" />
                        <TextBlock x:Name="CertificateText" Grid.Column="1" TextWrapping="Wrap" />
                    </Grid>
                    <TextBlock Text="Certificate-table presence only; signature validity, trust chain, signer identity, and online revocation status are not checked." FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
