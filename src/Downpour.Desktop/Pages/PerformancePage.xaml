<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="Downpour_Desktop.Pages.PerformancePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:Downpour_Desktop"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="24,20,24,36" Spacing="16">
            <ContentControl x:Name="BlossomHost" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" />
            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Foreground="{StaticResource HudCyanBrush}" Text="DOWNPOUR  /  MONITORING  /  PERFORMANCE" />
                    <TextBlock Style="{StaticResource TitleTextBlockStyle}" FontSize="30" Text="System performance" />
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Live CPU, physical-memory, and commit pressure with storage, network, and process telemetry." TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Top">
                    <Border Padding="12,8" CornerRadius="9" BorderThickness="1" BorderBrush="{StaticResource DownpourStrokeBrush}" Background="{StaticResource DownpourSurfaceBrush}">
                        <StackPanel Orientation="Horizontal" Spacing="8"><Ellipse x:Name="ServiceDot" Width="8" Height="8" Fill="#FFFFB455" VerticalAlignment="Center" /><TextBlock x:Name="ServiceState" FontSize="11" FontWeight="SemiBold" Text="CONNECTING" /></StackPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Right">
                        <Button x:Name="RefreshButton" Content="↻  Refresh" Click="Refresh_Click" ToolTipService.ToolTip="Request a fresh local system snapshot." />
                        <Button x:Name="PauseButton" Content="Ⅱ  Pause" Click="Pause_Click" ToolTipService.ToolTip="Pause or resume automatic sampling." />
                        <Button x:Name="ExportButton" Content="⇩  Export CSV" Click="Export_Click" ToolTipService.ToolTip="Save the current bounded CPU, memory, commit, network, and disk history as CSV." />
                        <ComboBox x:Name="IntervalCombo" Width="110" SelectionChanged="IntervalCombo_SelectionChanged" ToolTipService.ToolTip="Sampling interval">
                            <ComboBoxItem Content="1 sec" Tag="1" IsSelected="True" />
                            <ComboBoxItem Content="3 sec" Tag="3" />
                            <ComboBoxItem Content="5 sec" Tag="5" />
                            <ComboBoxItem Content="10 sec" Tag="10" />
                            <ComboBoxItem Content="30 sec" Tag="30" />
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <Border Padding="14,11" CornerRadius="10" Background="{StaticResource DownpourSurfaceBrush}" BorderBrush="{StaticResource DownpourStrokeBrush}" BorderThickness="1">
                <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE9D9;" FontSize="20" Foreground="{StaticResource HudCyanBrush}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Spacing="2"><TextBlock x:Name="StatusHeadline" FontWeight="SemiBold" Text="Connecting to local performance counters" /><TextBlock x:Name="StatusDescription" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Values remain unknown until current telemetry arrives." TextWrapping="Wrap" /></StackPanel>
                </Grid>
            </Border>

            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <StackPanel Spacing="16">
                <Border Padding="14" CornerRadius="12" Background="{StaticResource DownpourSurfaceBrush}" BorderBrush="{StaticResource DownpourStrokeBrush}" BorderThickness="1">
                    <StackPanel Spacing="8"><TextBlock FontSize="11" FontWeight="SemiBold" CharacterSpacing="120" Foreground="{StaticResource HudTextDimBrush}" Text="LIVE INSTRUMENTATION" HorizontalAlignment="Center" /><Grid x:Name="GaugeHost" ColumnSpacing="4" RowSpacing="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions></Grid><TextBlock x:Name="MemorySummary" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="Physical memory totals are unavailable" HorizontalAlignment="Center" TextWrapping="Wrap" /><TextBlock x:Name="CommitSummary" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="System commit counters unavailable" HorizontalAlignment="Center" TextWrapping="Wrap" /><TextBlock x:Name="PageFileSummary" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="Pagefile counters unavailable" HorizontalAlignment="Center" TextWrapping="Wrap" /><TextBlock x:Name="DiskIoSummary" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="Physical disk throughput is warming up" HorizontalAlignment="Center" TextWrapping="Wrap" /><TextBlock x:Name="GpuSummary" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="GPU counters are warming up" HorizontalAlignment="Center" TextWrapping="Wrap" /><TextBlock x:Name="ThermalSummary" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="Temperature unavailable" HorizontalAlignment="Center" TextWrapping="Wrap" /><TextBlock FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="OS-volume space, physical-disk I/O, and adapter rates are live readings" HorizontalAlignment="Center" TextWrapping="Wrap" /></StackPanel>
                </Border>
                <Border Padding="14" CornerRadius="12" Background="{StaticResource DownpourSurfaceBrush}" BorderBrush="{StaticResource DownpourStrokeBrush}" BorderThickness="1">
                    <StackPanel Spacing="8"><TextBlock FontSize="11" FontWeight="SemiBold" CharacterSpacing="120" Foreground="{StaticResource HudTextDimBrush}" Text="PER-CORE CPU" HorizontalAlignment="Center" /><Grid x:Name="PerCoreGaugeHost" ColumnSpacing="4" RowSpacing="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions></Grid><TextBlock x:Name="PerCoreCpuDetail" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="Per-core CPU utilization from Windows performance counters" HorizontalAlignment="Center" TextWrapping="Wrap" /></StackPanel>
                </Border>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="16" VerticalAlignment="Top">
                    <Border Padding="16,13" CornerRadius="12" Background="{StaticResource DownpourSurfaceBrush}" BorderBrush="{StaticResource DownpourStrokeBrush}" BorderThickness="1" SizeChanged="HistoryHost_SizeChanged">
                        <Grid RowSpacing="8"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="230" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="2"><TextBlock FontSize="14" FontWeight="SemiBold" Text="Live utilization history" /><TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="Two-minute window · gaps mark unavailable readings" /></StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center"><StackPanel Orientation="Horizontal" Spacing="5"><Ellipse Width="7" Height="7" Fill="#FF50DBF1" /><TextBlock FontSize="11" Text="CPU" /></StackPanel><StackPanel Orientation="Horizontal" Spacing="5"><Ellipse Width="7" Height="7" Fill="#FFB47AF8" /><TextBlock FontSize="11" Text="Memory" /></StackPanel><StackPanel Orientation="Horizontal" Spacing="5"><Ellipse Width="7" Height="7" Fill="#FFFFAE5C" /><TextBlock FontSize="11" Text="Commit" /></StackPanel></StackPanel>
                            </Grid>
                            <Grid Grid.Row="1"><Canvas x:Name="HistoryChart" IsHitTestVisible="False" AutomationProperties.Name="CPU, physical memory, and system commit utilization history from zero to one hundred percent, sampled every second. Gaps mean data was unavailable." /><TextBlock x:Name="HistoryEmpty" Text="Waiting for live readings" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Grid>
                            <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Oldest" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" /><TextBlock Grid.Column="1" Text="Samples every second" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" /><TextBlock Grid.Column="2" Text="Now" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" /></Grid>
                        </Grid>
                    </Border>
                <Border Padding="16,13" CornerRadius="12" Background="{StaticResource DownpourSurfaceBrush}" BorderBrush="{StaticResource DownpourStrokeBrush}" BorderThickness="1" SizeChanged="PerCoreHistoryHost_SizeChanged">
                    <Grid RowSpacing="8"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="230" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="2"><TextBlock FontSize="14" FontWeight="SemiBold" Text="Per-core CPU history" /><TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="Two-minute window · up to 16 logical processors" /></StackPanel>
                        </Grid>
                        <Grid Grid.Row="1"><Canvas x:Name="PerCoreHistoryChart" IsHitTestVisible="False" AutomationProperties.Name="Per-core CPU utilization history from zero to one hundred percent, sampled every second. Gaps mean data was unavailable." /><TextBlock x:Name="PerCoreHistoryEmpty" Text="Waiting for live readings" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Grid>
                        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Oldest" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" /><TextBlock Grid.Column="1" Text="Samples every second · per-core utilization" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" /><TextBlock Grid.Column="2" Text="Now" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" /></Grid>
                    </Grid>
                </Border>
                </StackPanel>
            </Grid>


            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Padding="15" CornerRadius="10" Background="{StaticResource DownpourSurfaceElevatedBrush}" BorderBrush="{StaticResource DownpourMutedStrokeBrush}" BorderThickness="1"><StackPanel Spacing="6"><TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="LOGICAL PROCESSORS" /><TextBlock x:Name="CpuCount" FontSize="23" FontWeight="SemiBold" Text="—" /><TextBlock x:Name="CpuDetail" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="System topology" /></StackPanel></Border>
                <Border Grid.Column="1" Padding="15" CornerRadius="10" Background="{StaticResource DownpourSurfaceElevatedBrush}" BorderBrush="{StaticResource DownpourMutedStrokeBrush}" BorderThickness="1"><StackPanel Spacing="6"><TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="PROCESSES" /><TextBlock x:Name="ProcessCount" FontSize="23" FontWeight="SemiBold" Text="—" /><TextBlock FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="Current system snapshot" /></StackPanel></Border>
                <Border Grid.Column="2" Padding="15" CornerRadius="10" Background="{StaticResource DownpourSurfaceElevatedBrush}" BorderBrush="{StaticResource DownpourMutedStrokeBrush}" BorderThickness="1"><StackPanel Spacing="6"><TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="ACTIVE TCP CONNECTIONS" /><TextBlock x:Name="ConnectionCount" FontSize="23" FontWeight="SemiBold" Text="—" /><TextBlock FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="Current local inventory" /></StackPanel></Border>
                <Border Grid.Column="3" Padding="15" CornerRadius="10" Background="{StaticResource DownpourSurfaceElevatedBrush}" BorderBrush="{StaticResource DownpourMutedStrokeBrush}" BorderThickness="1"><StackPanel Spacing="6"><TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="SYSTEM VOLUME" /><TextBlock x:Name="DiskValue" FontSize="20" FontWeight="SemiBold" Text="—" /><TextBlock x:Name="DiskDetail" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="Used / total" /></StackPanel></Border>
                <Border Grid.Column="4" Padding="15" CornerRadius="10" Background="{StaticResource DownpourSurfaceElevatedBrush}" BorderBrush="{StaticResource DownpourMutedStrokeBrush}" BorderThickness="1"><StackPanel Spacing="6"><TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="SYSTEM UPTIME" /><TextBlock x:Name="UptimeValue" FontSize="20" FontWeight="SemiBold" Text="—" /><TextBlock FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="Since Windows started" /></StackPanel></Border>
            </Grid>

            <Border Padding="16,13" CornerRadius="12" Background="{StaticResource DownpourSurfaceBrush}" BorderBrush="{StaticResource DownpourStrokeBrush}" BorderThickness="1" SizeChanged="NetworkHistoryHost_SizeChanged">
                <Grid RowSpacing="8"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="118" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Spacing="2"><TextBlock FontSize="14" FontWeight="SemiBold" Text="Network throughput history" /><TextBlock x:Name="NetworkChartScale" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="Waiting for two adapter samples" /></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center"><StackPanel Orientation="Horizontal" Spacing="5"><Ellipse Width="7" Height="7" Fill="#FF50DBF1" /><TextBlock FontSize="11" Text="Receive" /></StackPanel><StackPanel Orientation="Horizontal" Spacing="5"><Ellipse Width="7" Height="7" Fill="#FFB47AF8" /><TextBlock FontSize="11" Text="Send" /></StackPanel></StackPanel></Grid>
                    <Canvas x:Name="NetworkHistoryChart" Grid.Row="1" IsHitTestVisible="False" AutomationProperties.Name="Receive and send network throughput history. Missing readings remain gaps." />
                    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Oldest" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" /><TextBlock Grid.Column="1" Text="Samples every second · combined active adapters" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" /><TextBlock Grid.Column="2" Text="Now" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" /></Grid>
                </Grid>
            </Border>

            <Border Padding="16,13" CornerRadius="12" Background="{StaticResource DownpourSurfaceBrush}" BorderBrush="{StaticResource DownpourStrokeBrush}" BorderThickness="1" SizeChanged="DiskHistoryHost_SizeChanged">
                <Grid RowSpacing="8"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="118" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Spacing="2"><TextBlock FontSize="14" FontWeight="SemiBold" Text="Physical disk throughput" /><TextBlock x:Name="DiskChartScale" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="Waiting for Windows disk counters" /></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center"><StackPanel Orientation="Horizontal" Spacing="5"><Ellipse Width="7" Height="7" Fill="#FFFFAE5C" /><TextBlock FontSize="11" Text="Read" /></StackPanel><StackPanel Orientation="Horizontal" Spacing="5"><Ellipse Width="7" Height="7" Fill="#FFB47AF8" /><TextBlock FontSize="11" Text="Write" /></StackPanel></StackPanel></Grid>
                    <Canvas x:Name="DiskHistoryChart" Grid.Row="1" IsHitTestVisible="False" AutomationProperties.Name="System-wide physical disk read and write bytes per second. Missing readings remain gaps." />
                    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Oldest" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" /><TextBlock Grid.Column="1" Text="Samples every second · all physical disks" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" /><TextBlock Grid.Column="2" Text="Now" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" /></Grid>
                </Grid>
            </Border>

            <Border Padding="16,13" CornerRadius="12" Background="{StaticResource DownpourSurfaceBrush}" BorderBrush="{StaticResource DownpourStrokeBrush}" BorderThickness="1" SizeChanged="PerDiskHistoryHost_SizeChanged">
                <Grid RowSpacing="8"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="118" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Spacing="2"><TextBlock FontSize="14" FontWeight="SemiBold" Text="Per-disk I/O history" /><TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="Two-minute window · individual physical disks" /></StackPanel>
                    </Grid>
                    <Grid Grid.Row="1"><Canvas x:Name="PerDiskHistoryChart" IsHitTestVisible="False" AutomationProperties.Name="Per-disk read and write throughput history. Missing readings remain gaps." /><TextBlock x:Name="PerDiskHistoryEmpty" Text="Waiting for live readings" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Grid>
                    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Oldest" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" /><TextBlock Grid.Column="1" Text="Samples every second · per-disk I/O" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" /><TextBlock Grid.Column="2" Text="Now" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" /></Grid>
                </Grid>
            </Border>

            <Border Padding="14" CornerRadius="12" Background="{StaticResource DownpourSurfaceBrush}" BorderBrush="{StaticResource DownpourStrokeBrush}" BorderThickness="1">
                <StackPanel Spacing="8">
                    <TextBlock FontSize="11" FontWeight="SemiBold" CharacterSpacing="120" Foreground="{StaticResource HudTextDimBrush}" Text="PER-DISK I/O" HorizontalAlignment="Center" />
                    <Grid x:Name="PerDiskGaugeHost" ColumnSpacing="4" RowSpacing="2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    </Grid>
                    <TextBlock x:Name="PerDiskDetail" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="Per-disk read/write throughput from Windows PhysicalDisk counters" HorizontalAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Spacing="3"><TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="MEMORY PRESSURE" /><TextBlock FontSize="19" FontWeight="SemiBold" Text="Largest working sets" /></StackPanel><TextBlock Grid.Column="1" x:Name="ProcessWindowLabel" VerticalAlignment="Bottom" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="TOP 10 · CURRENT SAMPLE" /></Grid>
            <Grid ColumnSpacing="8" Margin="0,8,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <ComboBox x:Name="ProcessSortCombo" Width="160" SelectionChanged="ProcessSortCombo_SelectionChanged" ToolTipService.ToolTip="Sort process list by selected metric">
                    <ComboBoxItem Content="Memory (Working Set)" Tag="0" />
                    <ComboBoxItem Content="CPU %" Tag="1" />
                    <ComboBoxItem Content="PID" Tag="2" />
                    <ComboBoxItem Content="Name" Tag="3" />
                </ComboBox>
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                <TextBox x:Name="ProcessFilterBox" Width="360" PlaceholderText="Filter processes by name, PID, or detail..." TextChanged="ProcessFilterBox_TextChanged" />
                <Button x:Name="OpenLocationButton" Content="Open file location" Click="OpenLocation_Click" IsEnabled="False" ToolTipService.ToolTip="Show the selected process's program file in File Explorer." />
                <Button x:Name="EndProcessButton" Content="End process…" Click="EndProcess_Click" IsEnabled="False" ToolTipService.ToolTip="Review and end the selected process through Downpour's audited action broker." />
            </StackPanel>
            <TextBlock x:Name="ProcessActionStatus" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            <ListView x:Name="ProcessList" ItemsSource="{x:Bind Processes}" SelectionMode="Single" IsItemClickEnabled="False" Background="{StaticResource DownpourSurfaceBrush}" MaxHeight="440" SelectionChanged="ProcessList_SelectionChanged">
                <ListView.ItemTemplate><DataTemplate><Grid Padding="12,9" ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="2*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" Foreground="#FF5DCAE5" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" /><ProgressBar Style="{StaticResource HudMeterStyle}" Grid.Column="2" Minimum="0" Maximum="100" Value="{Binding MemoryShare}" VerticalAlignment="Center" /><TextBlock Grid.Column="3" Text="{Binding Detail}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" /></Grid></DataTemplate></ListView.ItemTemplate>
                <ListView.Footer><TextBlock Padding="12,10" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="Per-process CPU is normalized to total logical-processor capacity and remains unknown on the first sample or if access is denied. Physical disk throughput uses Windows PhysicalDisk(_Total) counters and may remain unknown if those counters are unavailable. Pagefile, per-core CPU, GPU, clocks, temperature, fan speed, and power are not currently collected." TextWrapping="Wrap" /></ListView.Footer>
            </ListView>

            <Border Padding="16,13" CornerRadius="12" Background="{StaticResource DownpourSurfaceBrush}" BorderBrush="{StaticResource DownpourStrokeBrush}" BorderThickness="1" SizeChanged="ProcessCpuHistoryHost_SizeChanged">
                <Grid RowSpacing="8"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="150" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Spacing="2"><TextBlock FontSize="14" FontWeight="SemiBold" Text="Process CPU history" /><TextBlock x:Name="ProcessCpuHistoryTitle" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="Select a process from the list to view CPU history" /></StackPanel>
                    </Grid>
                    <Grid Grid.Row="1"><Canvas x:Name="ProcessCpuHistoryChart" IsHitTestVisible="False" AutomationProperties.Name="Selected process CPU utilization history from zero to one hundred percent, sampled every second." /><TextBlock x:Name="ProcessCpuHistoryEmpty" Text="Select a process to view CPU history" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Grid>
                    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Oldest" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" /><TextBlock Grid.Column="1" Text="Samples every second · per-process CPU" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" /><TextBlock Grid.Column="2" Text="Now" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" /></Grid>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
