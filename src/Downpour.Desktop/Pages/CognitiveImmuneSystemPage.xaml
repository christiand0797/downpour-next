<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="Downpour_Desktop.Pages.CognitiveImmuneSystemPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="28,24,28,36" Spacing="18" MaxWidth="1080" HorizontalAlignment="Left">
            <StackPanel Spacing="5">
                <TextBlock Text="DEFENSE / MEASURED REVIEW" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock Text="Cognitive Immune System" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="Review actual local alerts, collection warnings, response policies, and package-file integrity. This page does not run autonomous remediation, forecast threats, or report simulated protection scores." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="AssessmentStatus" Text="Awaiting service measurements" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button x:Name="RefreshButton" Content="Refresh measurements" Click="Refresh_Click" />
                <Button x:Name="CopyReportButton" Content="Copy review report" IsEnabled="False" Click="CopyReport_Click" />
            </StackPanel>
            <InfoBar x:Name="NotificationInfoBar" IsOpen="False" IsClosable="True" />
            <Border Padding="18" CornerRadius="12" Background="{StaticResource DownpourSurfaceBrush}" BorderBrush="{StaticResource DownpourStrokeBrush}" BorderThickness="1">
                <StackPanel Spacing="10">
                    <TextBlock Text="Returned alert window" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock x:Name="WindowScope" Text="Unavailable counts are unknown." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="MeasuredCounts" Text="Open: unknown · Urgent open: unknown · User-verified active: unknown" TextWrapping="Wrap" />
                    <TextBlock x:Name="TechniqueCounts" Text="Suppressed: unknown · Observed techniques: unknown" TextWrapping="Wrap" />
                    <TextBlock Text="Urgent means HIGH/CRITICAL and still Open. User verification is a local review decision, not proof of malware. Counts cover only returned rows and do not measure threats contained." TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>
            <Border Padding="18" CornerRadius="12" Background="{StaticResource DownpourSurfaceBrush}" BorderBrush="{StaticResource DownpourStrokeBrush}" BorderThickness="1">
                <StackPanel Spacing="10">
                    <TextBlock Text="Source and policy measurements" FontSize="18" FontWeight="SemiBold" />
                    <ItemsControl x:Name="SourceList"><ItemsControl.ItemTemplate><DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,4" />
                    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    <TextBlock Text="Collection warnings" FontWeight="SemiBold" />
                    <ItemsControl x:Name="WarningList"><ItemsControl.ItemTemplate><DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,3" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                </StackPanel>
            </Border>
            <Border Padding="18" CornerRadius="12" Background="{StaticResource DownpourSurfaceBrush}" BorderBrush="{StaticResource DownpourStrokeBrush}" BorderThickness="1">
                <StackPanel Spacing="10">
                    <TextBlock Text="Package integrity" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="Explicitly compare listed installation files with release-manifest.json. Reads package files only, up to 2,000 files / 1 GiB with a 30-second deadline. Files and settings are never modified or uploaded. Extra files and user state are excluded. The unsigned local manifest can be replaced by the same user: matching hashes show consistency, not publisher authenticity or absence of malware." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button x:Name="IntegrityButton" Content="Check package files" Click="Integrity_Click" />
                        <Button x:Name="CancelIntegrityButton" Content="Cancel check" IsEnabled="False" Click="CancelIntegrity_Click" />
                    </StackPanel>
                    <TextBlock x:Name="IntegrityStatus" Text="Not checked" TextWrapping="Wrap" />
                    <TextBlock x:Name="IntegrityProgress" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ItemsControl x:Name="IntegrityFindings"><ItemsControl.ItemTemplate><DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,3" />
                    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                </StackPanel>
            </Border>
            <Border Padding="18" CornerRadius="12" Background="{StaticResource DownpourSurfaceBrush}" BorderBrush="{StaticResource DownpourStrokeBrush}" BorderThickness="1">
                <StackPanel Spacing="10">
                    <TextBlock Text="Recent alert measurements" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="Up to 32 recent rows from the validated alert window. Suppression and acknowledgment remain visible." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ItemsControl x:Name="RecentAlertList"><ItemsControl.ItemTemplate><DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,4" />
                    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    <TextBlock Text="Time-proximate cross-log observations" FontWeight="SemiBold" />
                    <ItemsControl x:Name="CorrelationList"><ItemsControl.ItemTemplate><DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,4" />
                    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Content="Review threats" Tag="threats" Click="Navigate_Click" />
                <Button Content="Scan a file" Tag="scanner" Click="Navigate_Click" />
                <Button Content="Review response" Tag="remediation" Click="Navigate_Click" />
                <Button Content="Settings" Tag="settings" Click="Navigate_Click" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
