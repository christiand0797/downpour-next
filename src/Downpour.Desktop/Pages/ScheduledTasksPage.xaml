<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="Downpour_Desktop.Pages.ScheduledTasksPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">
    <Grid Padding="24,20,24,30" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Foreground="{StaticResource HudCyanBrush}" Text="DOWNPOUR  /  MONITORING  /  TASK SCHEDULER" />
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" FontSize="30" Text="Scheduled tasks" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Every task in Task Scheduler, including hidden tasks, with state, run-as account, triggers, next and last run, and the action it starts. Read-only." TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="1" x:Name="RefreshButton" Content="Refresh now" Click="Refresh_Click" VerticalAlignment="Center" />
        </Grid>

        <Border Grid.Row="1" Padding="14,11" CornerRadius="10" Background="{StaticResource HudPanelBrush}" BorderBrush="{StaticResource HudEdgeBrush}" BorderThickness="1">
            <StackPanel Spacing="3">
                <TextBlock x:Name="StatusHeadline" FontWeight="SemiBold" Text="Reading Task Scheduler" />
                <TextBlock x:Name="StatusDetail" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="The service enumerates every Task Scheduler folder, including hidden tasks, and reads each task's definition." TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Grid x:Name="ChartRow" Grid.Row="2" />

        <Grid Grid.Row="3" ColumnSpacing="10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <AutoSuggestBox x:Name="SearchBox" PlaceholderText="Filter by task, folder, account, action or trigger" TextChanged="Filter_Changed" />
            <ComboBox Grid.Column="1" x:Name="StateFilter" MinWidth="150" SelectionChanged="Filter_Changed" />
            <CheckBox Grid.Column="2" x:Name="HiddenOnly" Content="Hidden only" Checked="Filter_Changed" Unchecked="Filter_Changed" VerticalAlignment="Center" />
            <TextBlock Grid.Column="3" x:Name="TaskCount" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="—" />
        </Grid>

        <Grid Grid.Row="4" RowSpacing="10">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid Padding="12,9" ColumnSpacing="12" Background="{StaticResource DownpourSurfaceElevatedBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="88" /><ColumnDefinition Width="2.6*" /><ColumnDefinition Width="1.4*" />
                    <ColumnDefinition Width="2.2*" /><ColumnDefinition Width="132" /><ColumnDefinition Width="132" /><ColumnDefinition Width="78" /><ColumnDefinition Width="40" />
                </Grid.ColumnDefinitions>
                <TextBlock FontSize="10" FontWeight="SemiBold" CharacterSpacing="65" Text="STATE" />
                <TextBlock Grid.Column="1" FontSize="10" FontWeight="SemiBold" CharacterSpacing="65" Text="TASK" />
                <TextBlock Grid.Column="2" FontSize="10" FontWeight="SemiBold" CharacterSpacing="65" Text="RUN AS" />
                <TextBlock Grid.Column="3" FontSize="10" FontWeight="SemiBold" CharacterSpacing="65" Text="TRIGGERS" />
                <TextBlock Grid.Column="4" FontSize="10" FontWeight="SemiBold" CharacterSpacing="65" Text="NEXT RUN" />
                <TextBlock Grid.Column="5" FontSize="10" FontWeight="SemiBold" CharacterSpacing="65" Text="LAST RUN" />
                <TextBlock Grid.Column="6" FontSize="10" FontWeight="SemiBold" CharacterSpacing="65" Text="CHANGE" />
            </Grid>

            <ListView x:Name="TaskList" Grid.Row="1" ItemsSource="{x:Bind Tasks}" SelectionMode="None" Background="{StaticResource DownpourSurfaceBrush}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="12,8" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="88" /><ColumnDefinition Width="2.6*" /><ColumnDefinition Width="1.4*" />
                                <ColumnDefinition Width="2.2*" /><ColumnDefinition Width="132" /><ColumnDefinition Width="132" /><ColumnDefinition Width="78" /><ColumnDefinition Width="40" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding State}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding StateBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Folder}" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding RunAs}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="3" Text="{Binding Triggers}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="4" Text="{Binding NextRun}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="5" Text="{Binding LastRun}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="6" Text="{Binding Change}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding ChangeBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <Button Grid.Column="7" Width="30" Height="30" Padding="0" HorizontalAlignment="Center" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" Click="RowMenu_Click" ToolTipService.ToolTip="Enable, disable, or delete this task">
                                <FontIcon Glyph="&#xE712;" FontSize="14" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
                <ListView.Footer>
                    <TextBlock x:Name="EmptyState" Padding="14" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="No scheduled tasks were reported." TextWrapping="Wrap" />
                </ListView.Footer>
            </ListView>
        </Grid>

        <TextBlock Grid.Row="5" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="Changes are explicit: enable, disable, or delete a task from its row menu, after a preview and a confirmation; every attempt is audited. Nothing runs a task on demand. Windows-owned tasks under \Microsoft\Windows and Downpour's own tasks stay protected. Hidden tasks are included. A task whose definition this account cannot read still appears with its action and state; missing parts stay blank. Next and last run are Task Scheduler's own wall-clock values. Last result is the scheduler's raw code and is not interpreted. The same tasks feed the persistence baseline, so an addition or change still raises a T1053.005 finding. The table updates on the next sensor capture." TextWrapping="Wrap" />
    </Grid>
</Page>
