<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="Downpour_Desktop.Pages.MemoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="24,20,24,30" Spacing="16">
            <!-- Header -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Foreground="#FFD2A8FF" Text="DOWNPOUR  /  FORENSICS  /  PROCESS MEMORY &amp; INJECTION MONITOR" />
                    <TextBlock Style="{StaticResource TitleTextBlockStyle}" FontSize="30" Text="Memory Forensics &amp; Process Injection Watch" />
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Live volatile memory review, process hollowing detection (T1055.012), path masquerading analysis, thread execution hijacking, and injection pattern scoring." TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button x:Name="ScanButton" Content="Scan All Processes" Style="{StaticResource AccentButtonStyle}" Click="Scan_Click" />
                    <Button x:Name="ToggleMonitorButton" Content="Start Auto-Monitor" Click="ToggleMonitor_Click" />
                    <Button x:Name="KillProcessButton" Content="Terminate Process" Click="KillProcess_Click" />
                    <Button x:Name="ExportReportButton" Content="Export Memory Report" Click="ExportReport_Click" />
                </StackPanel>
            </Grid>

            <!-- Overview Banner -->
            <Border Padding="16,14" CornerRadius="10" Background="#B9081220" BorderBrush="#423EC5D8" BorderThickness="1">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE8A5;" FontSize="28" Foreground="#FFD2A8FF" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                        <TextBlock x:Name="StatusHeadline" FontWeight="SemiBold" FontSize="14" Text="Memory Forensics Ready" />
                        <TextBlock x:Name="StatusDetail" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Click 'Scan All Processes' to evaluate running processes for code injection, path masquerading, and unbacked memory regions." TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                        <Border CornerRadius="8" Padding="12,8" Background="#163EC5D8">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock x:Name="TotalScannedText" Text="0" FontSize="18" FontWeight="Bold" Foreground="#FF60DBEE" HorizontalAlignment="Center" />
                                <TextBlock Text="Scanned" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Border CornerRadius="8" Padding="12,8" Background="#163EC5D8">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock x:Name="InjectedCountText" Text="0" FontSize="18" FontWeight="Bold" Foreground="#FFFF7B72" HorizontalAlignment="Center" />
                                <TextBlock Text="Injected" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Border CornerRadius="8" Padding="12,8" Background="#163EC5D8">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock x:Name="SuspiciousCountText" Text="0" FontSize="18" FontWeight="Bold" Foreground="#FFFA CA5E" HorizontalAlignment="Center" />
                                <TextBlock Text="Suspicious" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Border CornerRadius="8" Padding="12,8" Background="#163EC5D8">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock x:Name="CleanCountText" Text="0" FontSize="18" FontWeight="Bold" Foreground="#FF56D364" HorizontalAlignment="Center" />
                                <TextBlock Text="Clean" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Policy & Read-Only Notice -->
            <Border Padding="12,9" CornerRadius="8" Background="#263EC5D8" BorderBrush="#333EC5D8" BorderThickness="1">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE72E;" FontSize="16" Foreground="#FF60DBEE" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Execution Policy Notice: Process termination, thread suspension, and memory modification are guarded under least-privilege security policy. Terminating processes requires an audited action broker (DN-008). Passive memory inspection is active." VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Main Content: Two Columns -->
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left Column: Scanned Processes List -->
                <StackPanel Grid.Column="0" Spacing="8">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <AutoSuggestBox x:Name="ProcessSearchBox" PlaceholderText="Filter by process name, PID, or technique..." TextChanged="ProcessSearchBox_TextChanged" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Button x:Name="FilterAllButton" Content="All" Click="FilterAll_Click" />
                            <Button x:Name="FilterThreatsButton" Content="Threats Only" Click="FilterThreats_Click" />
                        </StackPanel>
                    </Grid>

                    <ListView x:Name="ProcessesList" ItemsSource="{x:Bind VisibleProcesses}" SelectionMode="Single" MinHeight="380" MaxHeight="520" Background="{StaticResource DownpourSurfaceBrush}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="12,8" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border CornerRadius="6" Padding="6,3" Background="{Binding SeverityBackground}" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Severity}" FontSize="10" FontWeight="SemiBold" Foreground="{Binding SeverityForeground}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding ProcessName}" FontWeight="SemiBold" FontSize="12" />
                                            <TextBlock Text="{Binding PidDisplay}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding ExecutablePath}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding TechniqueDisplay}" FontSize="10" Foreground="#FF58A6FF" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ScoreDisplay}" FontSize="12" FontWeight="Bold" Foreground="{Binding SeverityForeground}" HorizontalAlignment="Right" />
                                        <TextBlock Text="{Binding MemoryDisplay}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                        <ListView.Footer>
                            <TextBlock x:Name="EmptyProcessesText" Text="No processes to display. Click 'Scan All Processes' to evaluate running memory." Padding="14" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                        </ListView.Footer>
                    </ListView>
                </StackPanel>

                <!-- Right Column: Process Deep Details & Activity Log -->
                <StackPanel Grid.Column="1" Spacing="14">
                    <!-- Selected Process Details Card -->
                    <Border Padding="14,12" CornerRadius="8" Background="#161b22" BorderBrush="#30363d" BorderThickness="1">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Selected Process Memory Analysis" FontWeight="SemiBold" FontSize="13" Foreground="#FF58A6FF" />
                            <TextBlock x:Name="SelectedProcessTitle" Text="Select a process from the list for detailed memory review." FontWeight="SemiBold" FontSize="12" />
                            <TextBlock x:Name="SelectedProcessPath" Text="—" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            <TextBlock x:Name="SelectedProcessFindings" Text="—" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Activity Log & Report Preview -->
                    <StackPanel Spacing="6">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" FontSize="15" Text="Memory Forensics Activity Log &amp; Report" />
                        <TextBox x:Name="MemoryReportBox" FontFamily="Consolas" FontSize="11" MinHeight="300" MaxHeight="380" TextWrapping="Wrap" AcceptsReturn="True" IsReadOnly="True" Background="#0b1016" Foreground="#FFD2A8FF" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
