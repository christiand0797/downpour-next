<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="Downpour_Desktop.Pages.RansomwarePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="24,20,24,30" Spacing="16">
            <!-- Header -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Foreground="#FFFF7B72" Text="DOWNPOUR  /  PROTECTION  /  RANSOMWARE RESILIENCE &amp; CANARY WATCH" />
                    <TextBlock Style="{StaticResource TitleTextBlockStyle}" FontSize="30" Text="Ransomware Early Warning &amp; File Resilience" />
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Real-time decoy canary file monitoring, protected directory posture, Volume Shadow Copy (VSS) anti-recovery detection, and passive entropy disruption analysis." TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button x:Name="RefreshButton" Content="Refresh Posture" Style="{StaticResource AccentButtonStyle}" Click="Refresh_Click" />
                    <Button x:Name="DeployCanaryButton" Content="Deploy Canaries" Click="DeployCanaries_Click" />
                    <Button x:Name="RollbackButton" Content="Rollback Files" Click="Rollback_Click" />
                    <Button x:Name="ExportReportButton" Content="Export Defense Report" Click="ExportReport_Click" />
                </StackPanel>
            </Grid>

            <!-- Overview Banner -->
            <Border Padding="16,14" CornerRadius="10" Background="#B9081220" BorderBrush="#423EC5D8" BorderThickness="1">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE8D7;" FontSize="28" Foreground="#FFFF7B72" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                        <TextBlock x:Name="StatusHeadline" FontWeight="SemiBold" FontSize="14" Text="Ransomware Defense Active" />
                        <TextBlock x:Name="StatusDetail" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Protected directory baseline established. No canary disruption or rapid encryption activity observed." TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                        <Border CornerRadius="8" Padding="12,8" Background="#163EC5D8">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock x:Name="OverallStatusText" Text="PROTECTED" FontSize="16" FontWeight="Bold" Foreground="#FF56D364" HorizontalAlignment="Center" />
                                <TextBlock Text="Defense Status" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Border CornerRadius="8" Padding="12,8" Background="#163EC5D8">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock x:Name="ProtectedDirsCountText" Text="0" FontSize="18" FontWeight="Bold" Foreground="#FF60DBEE" HorizontalAlignment="Center" />
                                <TextBlock Text="Protected Dirs" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Border CornerRadius="8" Padding="12,8" Background="#163EC5D8">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock x:Name="FilesMonitoredCountText" Text="0" FontSize="18" FontWeight="Bold" Foreground="#FF60DBEE" HorizontalAlignment="Center" />
                                <TextBlock Text="Files Monitored" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Border CornerRadius="8" Padding="12,8" Background="#163EC5D8">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock x:Name="ThreatIndicatorsCountText" Text="0" FontSize="18" FontWeight="Bold" Foreground="#FF56D364" HorizontalAlignment="Center" />
                                <TextBlock Text="Threat Indicators" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Policy & Read-Only Notice -->
            <Border Padding="12,9" CornerRadius="8" Background="#263EC5D8" BorderBrush="#333EC5D8" BorderThickness="1">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE72E;" FontSize="16" Foreground="#FF60DBEE" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Execution Policy Notice: Automated file rollback, volume manipulation, and system changes are guarded under least-privilege policy. Performing rollback requires an audited action broker (DN-008). Passive entropy disruption analysis and canary monitoring are active." VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Main Content: Two Columns -->
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left Column: Protected Directories & Canaries -->
                <StackPanel Grid.Column="0" Spacing="14">
                    <!-- Protected Directories -->
                    <StackPanel Spacing="6">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" FontSize="15" Text="Protected User Directories" />
                        <ListView x:Name="DirectoriesList" ItemsSource="{x:Bind DirectoryRows}" SelectionMode="None" IsItemClickEnabled="False" MaxHeight="220" Background="{StaticResource DownpourSurfaceBrush}">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="12,8" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="&#xED25;" FontSize="16" Foreground="#FF60DBEE" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="12" />
                                            <TextBlock Text="{Binding Path}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Spacing="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding StatsDisplay}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                            <TextBlock Text="{Binding EntropyDisplay}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>

                    <!-- Canary Decoys -->
                    <StackPanel Spacing="6">
                        <Grid>
                            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" FontSize="15" Text="Canary Token Decoys" VerticalAlignment="Center" />
                            <TextBlock x:Name="CanarySummaryText" Text="0 canaries" HorizontalAlignment="Right" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                        </Grid>
                        <ListView x:Name="CanariesList" ItemsSource="{x:Bind CanaryRows}" SelectionMode="None" IsItemClickEnabled="False" MaxHeight="240" Background="{StaticResource DownpourSurfaceBrush}">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="12,8" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border CornerRadius="6" Padding="6,3" Background="{Binding StatusBackground}" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="SemiBold" Foreground="{Binding StatusForeground}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="12" />
                                            <TextBlock Text="{Binding DirectoryPath}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Spacing="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding EntropyDisplay}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                            <TextBlock Text="{Binding VerifiedDisplay}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </StackPanel>

                <!-- Right Column: Threat Indicators, VSS & Activity Log -->
                <StackPanel Grid.Column="1" Spacing="14">
                    <!-- Threat Indicators -->
                    <StackPanel Spacing="6">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" FontSize="15" Text="Detected Threat Indicators" />
                        <ListView x:Name="ThreatIndicatorsList" ItemsSource="{x:Bind IndicatorRows}" SelectionMode="None" IsItemClickEnabled="False" MinHeight="140" MaxHeight="200" Background="{StaticResource DownpourSurfaceBrush}">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="12,8" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border CornerRadius="6" Padding="6,3" Background="{Binding SeverityBackground}" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding Severity}" FontSize="10" FontWeight="SemiBold" Foreground="{Binding SeverityForeground}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Description}" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding TargetPath}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                            <ListView.Footer>
                                <TextBlock x:Name="EmptyIndicatorsText" Text="No ransomware notes, suspicious extensions, or canary disruptions detected." Padding="12" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                            </ListView.Footer>
                        </ListView>
                    </StackPanel>

                    <!-- Volume Shadow Copy Posture Card -->
                    <Border Padding="12,10" CornerRadius="8" Background="#161b22" BorderBrush="#30363d" BorderThickness="1">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE753;" FontSize="20" Foreground="#FF60DBEE" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="3">
                                <TextBlock Text="Volume Shadow Copy (VSS) Resiliency" FontWeight="SemiBold" FontSize="12" Foreground="#FF58A6FF" />
                                <TextBlock x:Name="VssDetailText" Text="VSS Service: Querying... Anti-recovery commands: None detected." FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Activity Log & Report Preview -->
                    <StackPanel Spacing="6">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" FontSize="15" Text="Defense Activity Log &amp; Threat Report" />
                        <TextBox x:Name="DefenseReportBox" FontFamily="Consolas" FontSize="11" MinHeight="180" MaxHeight="260" TextWrapping="Wrap" AcceptsReturn="True" IsReadOnly="True" Background="#0b1016" Foreground="#FF60DBEE" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
