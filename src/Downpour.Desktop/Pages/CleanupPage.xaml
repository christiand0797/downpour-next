<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="Downpour_Desktop.Pages.CleanupPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="24,20,24,30" Spacing="16">
            <!-- Header -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Foreground="{StaticResource HudCyanBrush}" Text="DOWNPOUR  /  OPERATIONS  /  CLEANUP CENTER" />
                    <TextBlock Style="{StaticResource TitleTextBlockStyle}" FontSize="30" Text="System &amp; Disk Cleanup Center" />
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Audit and inspect temporary data, crash dumps, system caches, and reclaimable space. Strictly read-only preview." TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button x:Name="ScanButton" Content="Scan Now" Style="{StaticResource AccentButtonStyle}" Click="Scan_Click" />
                    <Button Content="Export Report" Click="ExportReport_Click" />
                </StackPanel>
            </Grid>

            <!-- Overview Banner -->
            <Border Padding="16,14" CornerRadius="10" Background="{StaticResource HudPanelBrush}" BorderBrush="{StaticResource HudEdgeBrush}" BorderThickness="1">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE74D;" FontSize="28" Foreground="{StaticResource HudCyanBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                        <TextBlock x:Name="StatusHeadline" FontWeight="SemiBold" FontSize="14" Text="Cleanup space preview ready to scan" />
                        <TextBlock x:Name="StatusDetail" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Scans temporary directories, crash dumps, Windows Update caches, and the Recycle Bin without modifying files." TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                        <Border CornerRadius="8" Padding="12,8" Background="{StaticResource HudCyanTintBrush}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock x:Name="TotalSpaceText" Text="—" FontSize="20" FontWeight="Bold" Foreground="{StaticResource HudCyanBrush}" HorizontalAlignment="Center" />
                                <TextBlock Text="Total Reclaimable" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Border CornerRadius="8" Padding="12,8" Background="{StaticResource HudCyanTintBrush}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock x:Name="TotalFilesText" Text="—" FontSize="20" FontWeight="Bold" Foreground="{StaticResource HudCyanBrush}" HorizontalAlignment="Center" />
                                <TextBlock Text="Candidate Files" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Policy & Read-Only Notice -->
            <Border Padding="12,9" CornerRadius="8" Background="{StaticResource HudCyanTintBrush}" BorderBrush="{StaticResource HudEdgeBrush}" BorderThickness="1">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE72E;" FontSize="16" Foreground="{StaticResource HudCyanBrush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Read-Only Preview Mode: Per project policy, Downpour operates with least privilege. Deletion actions are disabled until an auditable Action Broker (DN-008) is approved and enabled." VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Categories Section -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" FontSize="16" Text="Reclaimable Space by Category" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Content="Clean Selected" IsEnabled="False" ToolTipService.ToolTip="File deletion disabled in read-only preview mode (requires DN-008 Action Broker)" />
                    <Button Content="Clean All" IsEnabled="False" ToolTipService.ToolTip="File deletion disabled in read-only preview mode (requires DN-008 Action Broker)" />
                </StackPanel>
            </Grid>

            <ListView x:Name="CategoriesList" ItemsSource="{x:Bind Categories}" SelectionMode="None" IsItemClickEnabled="False" Background="{StaticResource DownpourSurfaceBrush}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="12,10" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <!-- Risk Badge -->
                            <Border CornerRadius="6" Padding="6,3" Background="{Binding RiskBackground}" VerticalAlignment="Center" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding RiskLevel}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding RiskForeground}" HorizontalAlignment="Center" />
                            </Border>
                            <!-- Label & Description -->
                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Label}" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <!-- Size -->
                            <TextBlock Grid.Column="2" Text="{Binding FormattedSize}" FontFamily="Consolas" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource HudCyanBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                            <!-- Files -->
                            <TextBlock Grid.Column="3" Text="{Binding FormattedFiles}" FontFamily="Consolas" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                            <!-- Oldest Date -->
                            <StackPanel Grid.Column="4" Spacing="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding OldestItemDate}" FontFamily="Consolas" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" />
                                <TextBlock Text="{Binding LargestItemNote}" FontSize="9" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
                <ListView.Footer>
                    <TextBlock x:Name="EmptyCategoriesState" Padding="14" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="Click 'Scan Now' to calculate disk usage and candidate cleanup space." TextWrapping="Wrap" />
                </ListView.Footer>
            </ListView>

            <!-- Informational Footer -->
            <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="All calculations are made using standard filesystem metadata queries. File contents and credentials are never read or uploaded." TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
