<Page
    x:Class="Downpour_Desktop.Pages.ToolsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="16" Margin="24,16,24,24">

            <!-- Header Section -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="Operations &amp; Tools Launchpad" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource HudTextBrush}" />
                        <Border x:Name="StatusBadge" CornerRadius="4" Padding="8,2" VerticalAlignment="Center" Background="{StaticResource HudGreenTintBrush}" BorderBrush="{StaticResource HudGreenBrush}" BorderThickness="1">
                            <TextBlock x:Name="StatusBadgeText" Text="9 TOOLS OPERATIONAL" FontSize="11" FontWeight="Bold" Foreground="{StaticResource HudGreenBrush}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Unified operations hub for security tools, diagnostics, device controls, and platform utilities."
                               FontSize="13" Foreground="{StaticResource HudTextDimBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button x:Name="RefreshButton" Click="RefreshButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE72C;" FontSize="13" />
                            <TextBlock Text="Refresh Operations" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="DiagnosticsButton" Click="DiagnosticsButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xEC5A;" FontSize="13" Foreground="{StaticResource HudCyanBrush}" />
                            <TextBlock Text="Run Diagnostics" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ExportReportButton" Click="ExportReportButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xEDE1;" FontSize="13" />
                            <TextBlock Text="Export Operations Report" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Info Bar for Feedback -->
            <InfoBar x:Name="NotificationInfoBar" IsOpen="False" Severity="Informational" Margin="0,0,0,4" />

            <!-- Metrics Overview Cards -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource HudPanelBrush}" BorderBrush="{StaticResource HudStrokeMutedBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                    <StackPanel Spacing="4">
                        <TextBlock Text="OPERATIONAL TOOLS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource HudTextDimBrush}" />
                        <TextBlock x:Name="MetricTotalTools" Text="9 Registered" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource HudCyanBrush}" />
                        <TextBlock Text="Security &amp; ops subsystems" FontSize="12" Foreground="{StaticResource HudTextFaintBrush}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="{StaticResource HudPanelBrush}" BorderBrush="{StaticResource HudStrokeMutedBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                    <StackPanel Spacing="4">
                        <TextBlock Text="SYSTEM HEALTH" FontSize="11" FontWeight="Bold" Foreground="{StaticResource HudTextDimBrush}" />
                        <TextBlock x:Name="MetricSystemHealth" Text="Optimal" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource HudGreenBrush}" />
                        <TextBlock Text="Baseline tolerances verified" FontSize="12" Foreground="{StaticResource HudTextFaintBrush}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="{StaticResource HudPanelBrush}" BorderBrush="{StaticResource HudStrokeMutedBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                    <StackPanel Spacing="4">
                        <TextBlock Text="DIAGNOSTIC CHECKS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource HudTextDimBrush}" />
                        <TextBlock x:Name="MetricDiagnosticsPassed" Text="4/4 Passed" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource HudVioletBrush}" />
                        <TextBlock Text="Storage, memory, network, OS" FontSize="12" Foreground="{StaticResource HudTextFaintBrush}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Background="{StaticResource HudPanelBrush}" BorderBrush="{StaticResource HudStrokeMutedBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                    <StackPanel Spacing="4">
                        <TextBlock Text="RAPID LAUNCHPADS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource HudTextDimBrush}" />
                        <TextBlock Text="Direct Access" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource HudAmberBrush}" />
                        <TextBlock Text="Instant route navigation" FontSize="12" Foreground="{StaticResource HudTextFaintBrush}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- System Diagnostics Banner -->
            <Border Background="{StaticResource HudPanelBrush}" BorderBrush="{StaticResource HudStrokeMutedBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xEC5A;" FontSize="15" Foreground="{StaticResource HudCyanBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Host System Diagnostics" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource HudTextBrush}" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="Live Hardware &amp; Platform Status" FontSize="11" Foreground="{StaticResource HudTextFaintBrush}" VerticalAlignment="Center" />
                    </Grid>

                    <Grid x:Name="DiagnosticsGrid" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- OS Architecture -->
                        <Border Grid.Column="0" Background="{StaticResource HudPanelElevatedBrush}" BorderBrush="{StaticResource HudStrokeMutedBrush}" BorderThickness="1" CornerRadius="6" Padding="10">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Host Platform" FontSize="10" Foreground="{StaticResource HudTextDimBrush}" />
                                <TextBlock x:Name="DiagOsPlatform" Text="Windows 11" FontWeight="SemiBold" Foreground="{StaticResource HudTextBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="DiagOsDetails" Text="Native Architecture" FontSize="10" Foreground="{StaticResource HudTextFaintBrush}" />
                            </StackPanel>
                        </Border>

                        <!-- Storage -->
                        <Border Grid.Column="1" Background="{StaticResource HudPanelElevatedBrush}" BorderBrush="{StaticResource HudStrokeMutedBrush}" BorderThickness="1" CornerRadius="6" Padding="10">
                            <StackPanel Spacing="2">
                                <TextBlock Text="System Storage" FontSize="10" Foreground="{StaticResource HudTextDimBrush}" />
                                <TextBlock x:Name="DiagStorageCapacity" Text="Free Space" FontWeight="SemiBold" Foreground="{StaticResource HudGreenBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="DiagStorageDetails" Text="Adequate headroom" FontSize="10" Foreground="{StaticResource HudTextFaintBrush}" />
                            </StackPanel>
                        </Border>

                        <!-- Network -->
                        <Border Grid.Column="2" Background="{StaticResource HudPanelElevatedBrush}" BorderBrush="{StaticResource HudStrokeMutedBrush}" BorderThickness="1" CornerRadius="6" Padding="10">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Network Stack" FontSize="10" Foreground="{StaticResource HudTextDimBrush}" />
                                <TextBlock x:Name="DiagNetworkStatus" Text="Active Adapters" FontWeight="SemiBold" Foreground="{StaticResource HudCyanBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="DiagNetworkDetails" Text="Stack online" FontSize="10" Foreground="{StaticResource HudTextFaintBrush}" />
                            </StackPanel>
                        </Border>

                        <!-- Memory -->
                        <Border Grid.Column="3" Background="{StaticResource HudPanelElevatedBrush}" BorderBrush="{StaticResource HudStrokeMutedBrush}" BorderThickness="1" CornerRadius="6" Padding="10">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Memory Baseline" FontSize="10" Foreground="{StaticResource HudTextDimBrush}" />
                                <TextBlock x:Name="DiagMemoryStatus" Text="Working Set" FontWeight="SemiBold" Foreground="{StaticResource HudVioletBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="DiagMemoryDetails" Text="Within bounds" FontSize="10" Foreground="{StaticResource HudTextFaintBrush}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Operational Tools Launchpad Grid -->
            <Border Background="{StaticResource HudPanelBrush}" BorderBrush="{StaticResource HudStrokeMutedBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE713;" FontSize="15" Foreground="{StaticResource HudAmberBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Operational Tools &amp; Utilities Launchpad" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource HudTextBrush}" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="Click Launch to open dedicated route" FontSize="11" Foreground="{StaticResource HudTextFaintBrush}" VerticalAlignment="Center" />
                    </Grid>

                    <ItemsControl x:Name="ToolsItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource HudPanelElevatedBrush}" BorderBrush="{StaticResource HudStrokeMutedBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,3,0,3">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Icon -->
                                        <Border Grid.Column="0" Background="{StaticResource HudPanelBrush}" BorderBrush="{StaticResource HudStrokeMutedBrush}" BorderThickness="1" CornerRadius="6" Width="40" Height="40" Margin="0,0,12,0">
                                            <FontIcon Glyph="{Binding Glyph}" FontSize="18" Foreground="{StaticResource HudCyanBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                        <!-- Content -->
                                        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{StaticResource HudTextBrush}" FontSize="13" />
                                                <Border Background="{StaticResource HudPanelBrush}" BorderBrush="{StaticResource HudStrokeMutedBrush}" BorderThickness="1" CornerRadius="3" Padding="6,1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Category}" FontSize="10" Foreground="{StaticResource HudTextDimBrush}" />
                                                </Border>
                                                <Border Background="{StaticResource HudGreenTintBrush}" CornerRadius="3" Padding="6,1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource HudGreenBrush}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Summary}" FontSize="11" Foreground="{StaticResource HudTextDimBrush}" TextWrapping="Wrap" />
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <TextBlock Text="{Binding TelemetryLabel}" FontSize="10" Foreground="{StaticResource HudTextFaintBrush}" />
                                                <TextBlock Text=":" FontSize="10" Foreground="{StaticResource HudTextFaintBrush}" />
                                                <TextBlock Text="{Binding TelemetryValue}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource HudCyanBrush}" />
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Launch Button -->
                                        <Button Grid.Column="2" Tag="{Binding RouteId}" Click="LaunchToolButton_Click" VerticalAlignment="Center" Margin="12,0,0,0">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE8A7;" FontSize="11" />
                                                <TextBlock Text="Launch Tool" FontSize="11" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
