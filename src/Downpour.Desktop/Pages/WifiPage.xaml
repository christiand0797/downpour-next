<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="Downpour_Desktop.Pages.WifiPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="24,20,24,30" Spacing="14">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Foreground="{StaticResource HudCyanBrush}" Text="DOWNPOUR  /  MONITORING  /  WIRELESS" />
                    <TextBlock Style="{StaticResource TitleTextBlockStyle}" FontSize="30" Text="Wi-Fi &amp; Wireless Posture" />
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Wireless network posture, access points, Evil Twin detection, and paired Bluetooth device inventory. Read-only." TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" x:Name="RefreshButton" Content="Re-check" Click="Refresh_Click" VerticalAlignment="Center" />
            </Grid>

            <Grid x:Name="ChartRow" />

            <Border Padding="14,11" CornerRadius="10" Background="{StaticResource HudPanelBrush}" BorderBrush="{StaticResource HudEdgeBrush}" BorderThickness="1">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE701;" FontSize="20" Foreground="{StaticResource HudCyanBrush}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Spacing="3">
                        <TextBlock x:Name="StatusHeadline" FontWeight="SemiBold" Text="Checking wireless posture" />
                        <TextBlock x:Name="StatusDetail" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Readings come from WLAN queries and the Bluetooth device registry. Strictly read-only." TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Findings section -->
            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" FontSize="16" Text="Security Findings" Margin="0,8,0,0" />
            <ListView ItemsSource="{x:Bind Findings}" SelectionMode="None" IsItemClickEnabled="False" Background="{StaticResource DownpourSurfaceBrush}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="12,10" ColumnSpacing="14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="96" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Border CornerRadius="6" Padding="8,4" Background="{Binding SeverityBackground}" VerticalAlignment="Top">
                                <TextBlock Text="{Binding Severity}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding SeverityForeground}" HorizontalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="3">
                                <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Indicator}" FontFamily="Consolas" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding Technique}" FontFamily="Consolas" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Top" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
                <ListView.Footer>
                    <TextBlock x:Name="EmptyFindingsState" Padding="14" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="No wireless security findings detected." TextWrapping="Wrap" />
                </ListView.Footer>
            </ListView>

            <!-- Visible Networks section -->
            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" FontSize="16" Text="Visible Wi-Fi Networks" Margin="0,8,0,0" />
            <ListView ItemsSource="{x:Bind Networks}" SelectionMode="None" IsItemClickEnabled="False" Background="{StaticResource DownpourSurfaceBrush}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="12,10" ColumnSpacing="14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Border Width="48" CornerRadius="6" Padding="4,4" Background="{Binding SignalBackground}" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SignalDisplay}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding SignalForeground}" HorizontalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="3">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding SsidDisplay}" FontWeight="SemiBold" />
                                    <Border CornerRadius="4" Padding="6,1" Background="#423EC5D8" Visibility="{Binding ConnectedVisibility}">
                                        <TextBlock Text="CONNECTED" FontSize="10" FontWeight="Bold" Foreground="{StaticResource HudCyanBrush}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding Details}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Border Grid.Column="2" CornerRadius="4" Padding="8,3" Background="{Binding AuthBackground}" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Authentication}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding AuthForeground}" />
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
                <ListView.Footer>
                    <TextBlock x:Name="EmptyNetworksState" Padding="14" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="No Wi-Fi networks discovered or adapter is powered down." TextWrapping="Wrap" />
                </ListView.Footer>
            </ListView>

            <!-- Paired Bluetooth Devices section -->
            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" FontSize="16" Text="Paired Bluetooth Devices" Margin="0,8,0,0" />
            <ListView ItemsSource="{x:Bind BluetoothDevices}" SelectionMode="None" IsItemClickEnabled="False" Background="{StaticResource DownpourSurfaceBrush}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="12,8" ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" />
                                    <Border CornerRadius="4" Padding="6,1" Background="#56FF3C3C" Visibility="{Binding SuspiciousVisibility}">
                                        <TextBlock Text="SUSPICIOUS NAME" FontSize="10" FontWeight="Bold" Foreground="#FFFF5050" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding Address}" FontFamily="Consolas" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <FontIcon Grid.Column="1" Glyph="&#xE702;" FontSize="16" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
                <ListView.Footer>
                    <TextBlock x:Name="EmptyBtState" Padding="14" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="No paired Bluetooth devices recorded." TextWrapping="Wrap" />
                </ListView.Footer>
            </ListView>

            <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="Read-only wireless posture monitoring. Deauthentication defense, interface disconnection, and radio disabling are disabled by default and require the audited action broker." TextWrapping="Wrap" Margin="0,8,0,0" />
        </StackPanel>
    </ScrollViewer>
</Page>
