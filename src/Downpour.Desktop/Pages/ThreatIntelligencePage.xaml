<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="Downpour_Desktop.Pages.ThreatIntelligencePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="28,24,28,36" Spacing="16" MaxWidth="1280" HorizontalAlignment="Left">
            <StackPanel Spacing="5">
                <TextBlock Text="ANALYSIS  /  THREAT INTELLIGENCE  /  OSINT FEEDS" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock Text="Threat Intelligence" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="Real-time malware URL feeds (URLhaus), C2 infrastructure (Feodo Tracker), malware samples (Malware Bazaar), and SSL/TLS fingerprints (SSL Blacklist) from Abuse.ch." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>

            <Border Padding="14" CornerRadius="10" Background="#A80B1524" BorderBrush="#3D46C5D8" BorderThickness="1">
                <StackPanel Spacing="8">
                    <TextBlock Text="These feeds are fetched on-demand from public APIs. No automatic polling or local storage of feed data occurs. Query results are cached for the session only." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    <TextBlock Text="URLhaus: malware URLs, payloads, tags • Abuse.ch: Malware Bazaar samples, Feodo Tracker C2 IPs, SSL Blacklist JA3 fingerprints" FontSize="11" Foreground="#FF91AFC2" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Grid ColumnSpacing="12" RowSpacing="8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock x:Name="StatusText" Text="Ready to query feeds." FontWeight="SemiBold" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" x:Name="RefreshUrlhausButton" Content="Fetch URLhaus recent" Click="FetchUrlhausRecent_Click" VerticalAlignment="Center" ToolTipService.ToolTip="Fetch recent malware URLs from URLhaus (default 1000)" />
                <Button Grid.Column="2" x:Name="RefreshAbuseChButton" Content="Fetch Abuse.ch feeds" Click="FetchAbuseChFeeds_Click" VerticalAlignment="Center" ToolTipService.ToolTip="Fetch Malware Bazaar recent samples, Feodo Tracker C2 IPs, and SSL Blacklist" />
            </Grid>

            <TextBox x:Name="SearchBox" PlaceholderText="Filter results by URL, hash, IP, tag, or malware family..." TextChanged="SearchBox_TextChanged" />

            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Padding="12" CornerRadius="10" Background="#C808111E" BorderBrush="#5738B9D1" BorderThickness="1">
                    <StackPanel Spacing="9">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="URLHAUS RECENT URLS" FontSize="11" FontWeight="SemiBold" CharacterSpacing="85" Foreground="#FF91AFC2" /><TextBlock x:Name="UrlhausCount" Grid.Column="1" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></Grid>
                        <ListView x:Name="UrlhausList" ItemsSource="{x:Bind VisibleUrlhausUrls}" SelectionMode="None" IsItemClickEnabled="False" MaxHeight="400" Background="Transparent">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Padding="8,7" Spacing="3">
                                        <TextBlock Text="{Binding Url}" FontWeight="SemiBold" Foreground="#FF50DBF1" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Threat}" FontSize="11" Foreground="#FFB47AF8" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding TagsDisplay}" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding DateAddedDisplay}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock x:Name="UrlhausEmpty" Text="Click 'Fetch URLhaus recent' to load data." Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Padding="12" CornerRadius="10" Background="#C808111E" BorderBrush="#5738B9D1" BorderThickness="1">
                    <StackPanel Spacing="9">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="MALWARE BAZAAR RECENT" FontSize="11" FontWeight="SemiBold" CharacterSpacing="55" Foreground="#FF91AFC2" TextWrapping="Wrap" /><TextBlock x:Name="MalwareBazaarCount" Grid.Column="1" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></Grid>
                        <ListView x:Name="MalwareBazaarList" ItemsSource="{x:Bind VisibleMalwareBazaar}" SelectionMode="None" IsItemClickEnabled="False" MaxHeight="400" Background="Transparent">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Padding="8,7" Spacing="3">
                                        <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" Foreground="#FF50DBF1" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Signature}" FontSize="11" Foreground="#FFB47AF8" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding TagsDisplay}" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding HashesDisplay}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock x:Name="MalwareBazaarEmpty" Text="Click 'Fetch Abuse.ch feeds' to load data." Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Padding="12" CornerRadius="10" Background="#C808111E" BorderBrush="#5738B9D1" BorderThickness="1">
                    <StackPanel Spacing="9">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="FEODO TRACKER C2 IPS" FontSize="11" FontWeight="SemiBold" CharacterSpacing="85" Foreground="#FF91AFC2" /><TextBlock x:Name="FeodoCount" Grid.Column="1" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></Grid>
                        <ListView x:Name="FeodoList" ItemsSource="{x:Bind VisibleFeodo}" SelectionMode="None" IsItemClickEnabled="False" MaxHeight="400" Background="Transparent">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Padding="8,7" Spacing="3">
                                        <TextBlock Text="{Binding IpPort}" FontWeight="SemiBold" Foreground="#FF50DBF1" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Malware}" FontSize="11" Foreground="#FFB47AF8" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding LocationDisplay}" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding StatusDisplay}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock x:Name="FeodoEmpty" Text="Click 'Fetch Abuse.ch feeds' to load data." Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Padding="12" CornerRadius="10" Background="#C808111E" BorderBrush="#5738B9D1" BorderThickness="1">
                    <StackPanel Spacing="9">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="SSL BLACKLIST (JA3)" FontSize="11" FontWeight="SemiBold" CharacterSpacing="55" Foreground="#FF91AFC2" TextWrapping="Wrap" /><TextBlock x:Name="SslBlacklistCount" Grid.Column="1" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></Grid>
                        <ListView x:Name="SslBlacklistList" ItemsSource="{x:Bind VisibleSslBlacklist}" SelectionMode="None" IsItemClickEnabled="False" MaxHeight="400" Background="Transparent">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Padding="8,7" Spacing="3">
                                        <TextBlock Text="{Binding Ja3Display}" FontWeight="SemiBold" Foreground="#FF50DBF1" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" FontFamily="Consolas" FontSize="10" />
                                        <TextBlock Text="{Binding Reason}" FontSize="11" Foreground="#FFB47AF8" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding DateDisplay}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock x:Name="SslBlacklistEmpty" Text="Click 'Fetch Abuse.ch feeds' to load data." Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>