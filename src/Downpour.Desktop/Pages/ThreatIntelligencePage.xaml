<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Downpour_Desktop.Pages.ThreatIntelligencePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:pages="using:Downpour_Desktop.Pages"
    Background="Transparent">
    <Page.Resources>
        <DataTemplate x:Key="EntryTemplate" x:DataType="pages:FeedEntryRow">
            <Grid Padding="0,5" ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" MinWidth="200" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="3*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind Value}" Foreground="{StaticResource HudCyanBrush}" IsTextSelectionEnabled="True" TextTrimming="CharacterEllipsis" FontFamily="Cascadia Mono, Consolas" FontSize="13" />
                <TextBlock Grid.Column="1" Text="{x:Bind Type}" Foreground="{StaticResource HudMagentaBrush}" FontSize="12" CharacterSpacing="80" />
                <TextBlock Grid.Column="2" Text="{x:Bind Label}" Foreground="{StaticResource HudTextDimBrush}" TextTrimming="CharacterEllipsis" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="28,22,28,24" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Text="ANALYSIS / OPEN-SOURCE INTELLIGENCE" Style="{StaticResource HudEyebrowStyle}" />
                <TextBlock Text="Threat Intel Feeds" Style="{StaticResource HudPageTitleStyle}" />
                <Rectangle Height="2" Fill="{StaticResource HudHeaderRuleBrush}" Margin="0,4,0,2" />
                <TextBlock Foreground="{StaticResource HudTextDimBrush}" TextWrapping="Wrap" MaxWidth="900" HorizontalAlignment="Left"
                           Text="Browse and search every downloaded database: abuse.ch ThreatFox, URLhaus, MalwareBazaar and Feodo Tracker, Spamhaus, Emerging Threats, LOLDrivers, phishing and stalkerware lists and more. Searching happens on this PC; nothing is sent anywhere." />
            </StackPanel>
            <Button Grid.Column="1" VerticalAlignment="Top" Click="OpenDatabases_Click">
                <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE1D3;" FontSize="14" /><TextBlock Text="Database status &amp; matches" /></StackPanel>
            </Button>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="FeedPicker" HorizontalAlignment="Stretch" PlaceholderText="Choose a database" SelectionChanged="FeedPicker_SelectionChanged" />
            <TextBox x:Name="SearchBox" Grid.Column="1" PlaceholderText="Search entries, malware families or labels (e.g. QakBot, Lumma, RTCore64, 185.220.)" MaxLength="128" TextChanged="SearchBox_TextChanged" />
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource HudCardStyle}" Padding="16,10">
            <Grid ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="ENTRIES" Style="{StaticResource HudCaptionStyle}" />
                    <TextBlock x:Name="TotalText" Text="—" Style="{StaticResource HudMetricStyle}" FontSize="24" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="MATCHING" Style="{StaticResource HudCaptionStyle}" />
                    <TextBlock x:Name="MatchingText" Text="—" Style="{StaticResource HudMetricStyle}" FontSize="24" Foreground="{StaticResource HudMagentaBrush}" />
                </StackPanel>
                <TextBlock x:Name="FeedDetail" Grid.Column="2" Foreground="{StaticResource HudTextDimBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource HudCardStyle}" Padding="16,8">
            <Grid>
                <ListView x:Name="EntryList" ItemTemplate="{StaticResource EntryTemplate}" SelectionMode="None" />
                <TextBlock x:Name="EmptyText" Foreground="{StaticResource HudTextFaintBrush}" TextWrapping="Wrap" VerticalAlignment="Top" Margin="0,8" />
            </Grid>
        </Border>
    </Grid>
</Page>
