<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="Downpour_Desktop.Pages.NetworkPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="24,20,24,36" Spacing="16">
            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Foreground="#FF76DDF5" Text="DOWNPOUR  /  MONITORING  /  NETWORK" />
                    <TextBlock Style="{StaticResource TitleTextBlockStyle}" FontSize="30" Text="Network activity" />
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Inspect adapter throughput and current TCP connections. Collection is local and read-only." TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" Content="Refresh" Click="Refresh_Click" VerticalAlignment="Top" />
            </Grid>

            <Border Padding="14,11" CornerRadius="10" Background="#B9081220" BorderBrush="#423EC5D8" BorderThickness="1">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE774;" FontSize="20" Foreground="#FF60DBEE" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock x:Name="NetworkHeadline" FontWeight="SemiBold" Text="Connecting to the local sensor service" />
                        <TextBlock x:Name="NetworkDescription" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Adapter throughput becomes available after two samples." TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Padding="16" CornerRadius="10" Background="#C808111E" BorderBrush="#5738B9D1" BorderThickness="1">
                    <StackPanel Spacing="5"><TextBlock FontSize="11" CharacterSpacing="100" Foreground="#FF91AFC2" Text="RECEIVING" /><TextBlock x:Name="ReceiveRate" FontSize="24" FontWeight="SemiBold" Text="—" /><TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="Combined adapter throughput" /></StackPanel>
                </Border>
                <Border Grid.Column="1" Padding="16" CornerRadius="10" Background="#C808111E" BorderBrush="#5738B9D1" BorderThickness="1">
                    <StackPanel Spacing="5"><TextBlock FontSize="11" CharacterSpacing="100" Foreground="#FF91AFC2" Text="SENDING" /><TextBlock x:Name="SendRate" FontSize="24" FontWeight="SemiBold" Text="—" /><TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="Combined adapter throughput" /></StackPanel>
                </Border>
                <Border Grid.Column="2" Padding="16" CornerRadius="10" Background="#C808111E" BorderBrush="#5738B9D1" BorderThickness="1">
                    <StackPanel Spacing="5"><TextBlock FontSize="11" CharacterSpacing="100" Foreground="#FF91AFC2" Text="TCP CONNECTIONS" /><TextBlock x:Name="ConnectionCount" FontSize="24" FontWeight="SemiBold" Text="—" /><TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="Active connections · first 256 shown" /></StackPanel>
                </Border>
            </Grid>

            <Border Padding="16,13" CornerRadius="12" Background="#C808111E" BorderBrush="#5738B9D1" BorderThickness="1" SizeChanged="HistoryHost_SizeChanged">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="150" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Spacing="2"><TextBlock FontSize="14" FontWeight="SemiBold" Text="Throughput history" /><TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="Last 60 samples · gaps indicate unavailable samples" /></StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="5"><Ellipse Width="7" Height="7" Fill="#FF50DBF1" /><TextBlock FontSize="11" Text="Receive" /></StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="5"><Ellipse Width="7" Height="7" Fill="#FFB47AF8" /><TextBlock FontSize="11" Text="Send" /></StackPanel>
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="1"><Canvas x:Name="HistoryChart" IsHitTestVisible="False" /><TextBlock x:Name="HistoryScale" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,4,0" FontSize="9" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="Peak —" IsHitTestVisible="False" /></Grid>
                    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Oldest" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" /><TextBlock Grid.Column="1" x:Name="HistoryFootnote" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="Rates sampled every 3 seconds · totals are interface counters" HorizontalAlignment="Center" /><TextBlock Grid.Column="2" Text="Now" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" /></Grid>
                </Grid>
            </Border>

            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="NETWORK ADAPTERS" />
            <ListView ItemsSource="{x:Bind Interfaces}" SelectionMode="None" IsItemClickEnabled="False" Background="#B807101D" MaxHeight="320">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="12,10" ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="3"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" /></StackPanel>
                            <StackPanel Grid.Column="1" Spacing="2" MinWidth="100"><TextBlock Text="{Binding ReceiveRate}" Foreground="#FF50DBF1" FontSize="12" /><TextBlock Text="{Binding ReceivedTotal}" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" /></StackPanel>
                            <StackPanel Grid.Column="2" Spacing="2" MinWidth="100"><TextBlock Text="{Binding SendRate}" Foreground="#FFB47AF8" FontSize="12" /><TextBlock Text="{Binding SentTotal}" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" /></StackPanel>
                            <TextBlock Grid.Column="3" Text="{Binding Status}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Spacing="3"><TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="CURRENT CONNECTIONS" /><TextBlock FontSize="19" FontWeight="SemiBold" Text="Active TCP endpoints" /></StackPanel>
                <TextBlock Grid.Column="1" x:Name="ConnectionFootnote" VerticalAlignment="Bottom" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="READ ONLY" />
            </Grid>
            <ListView ItemsSource="{x:Bind Connections}" SelectionMode="None" IsItemClickEnabled="False" Background="#B807101D" MaxHeight="420">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="10,8" ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding LocalEndpoint}" FontFamily="Consolas" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding RemoteEndpoint}" FontFamily="Consolas" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding State}" FontSize="11" Foreground="#FF91D9E7" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock x:Name="ConnectionEmpty" Text="No active TCP connections were reported." FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="Endpoint inventory is local and read-only. Process ownership, packet contents, DNS history, and threat classification are not collected in this build." TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
