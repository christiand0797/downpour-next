<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="Downpour_Desktop.Pages.SandboxPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="24,20,24,30" Spacing="16">
            <!-- Header -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Foreground="#FF76DDF5" Text="DOWNPOUR  /  ANALYSIS  /  FILE SANDBOX &amp; ARTIFACT REVIEW" />
                    <TextBlock Style="{StaticResource TitleTextBlockStyle}" FontSize="30" Text="Isolated File Sandbox &amp; Static Analysis" />
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Inspect suspicious binaries, scripts, and PE artifacts in a safe, non-destructive environment. Shannon entropy, PE structural review, W^X detection, and API pattern scoring." TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button x:Name="BrowseButton" Content="Browse Sample..." Style="{StaticResource AccentButtonStyle}" Click="Browse_Click" />
                    <Button x:Name="AnalyzeButton" Content="Analyze Static Only" Click="AnalyzeStatic_Click" />
                    <Button x:Name="DetonateButton" Content="Detonate in Sandbox" Click="Detonate_Click" />
                    <Button x:Name="ExportReportButton" Content="Export Threat Report" Click="ExportReport_Click" />
                    <Button Content="Clear" Click="Clear_Click" />
                </StackPanel>
            </Grid>

            <!-- Overview Banner -->
            <Border Padding="16,14" CornerRadius="10" Background="#B9081220" BorderBrush="#423EC5D8" BorderThickness="1">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE7B8;" FontSize="28" Foreground="#FF60DBEE" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                        <TextBlock x:Name="StatusHeadline" FontWeight="SemiBold" FontSize="14" Text="File Sandbox Ready" />
                        <TextBlock x:Name="StatusDetail" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Select an executable (.exe, .dll, .sys), script, or binary file to compute Shannon entropy, cryptographic hashes, and behavioral indicators." TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                        <Border CornerRadius="8" Padding="12,8" Background="#163EC5D8">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock x:Name="VerdictText" Text="—" FontSize="18" FontWeight="Bold" Foreground="#FF60DBEE" HorizontalAlignment="Center" />
                                <TextBlock Text="Verdict" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Border CornerRadius="8" Padding="12,8" Background="#163EC5D8">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock x:Name="RiskScoreText" Text="—" FontSize="20" FontWeight="Bold" Foreground="#FFFF7B72" HorizontalAlignment="Center" />
                                <TextBlock Text="Risk Score" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Border CornerRadius="8" Padding="12,8" Background="#163EC5D8">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock x:Name="EntropyText" Text="—" FontSize="20" FontWeight="Bold" Foreground="#FF76DDF5" HorizontalAlignment="Center" />
                                <TextBlock Text="Shannon Entropy" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Policy & Read-Only Notice -->
            <Border Padding="12,9" CornerRadius="8" Background="#263EC5D8" BorderBrush="#333EC5D8" BorderThickness="1">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE72E;" FontSize="16" Foreground="#FF60DBEE" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Host Detonation Policy: Dynamic detonation on the host machine is restricted under least-privilege security policy. Executing untrusted binaries requires an isolated Hyper-V / Windows Sandbox container broker (DN-008). Safe static inspection is active." VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Target Sample File Bar -->
            <Border Padding="14,12" CornerRadius="8" Background="#121622" BorderBrush="#333EC5D8" BorderThickness="1">
                <Grid ColumnSpacing="12" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Selected Sample:" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="FilePathBox" PlaceholderText="Select a suspicious sample or enter absolute file path..." IsReadOnly="False" />

                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="16">
                        <TextBlock x:Name="FileSizeLabel" Text="Size: —" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="FormatLabel" Text="Format: —" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="Sha256Label" Text="SHA-256: —" FontSize="11" FontFamily="Consolas" Foreground="#FF58A6FF" IsTextSelectionEnabled="True" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Content: Two Columns -->
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left Column: Triggered Behavioral & API Indicators -->
                <StackPanel Grid.Column="0" Spacing="8">
                    <Grid>
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" FontSize="15" Text="Behavioral &amp; API Indicators" VerticalAlignment="Center" />
                        <TextBlock x:Name="IndicatorSummaryText" Text="0 indicators" HorizontalAlignment="Right" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                    </Grid>

                    <ListView x:Name="IndicatorsList" ItemsSource="{x:Bind IndicatorRows}" SelectionMode="None" IsItemClickEnabled="False" MinHeight="320" MaxHeight="450" Background="{StaticResource DownpourSurfaceBrush}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="12,9" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Category Badge -->
                                    <Border CornerRadius="6" Padding="6,3" Background="{Binding CategoryBackground}" VerticalAlignment="Center" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding Category}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding CategoryForeground}" HorizontalAlignment="Center" />
                                    </Border>

                                    <!-- Indicator & Description -->
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Indicator}" FontSize="12" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>

                                    <!-- Weight -->
                                    <TextBlock Grid.Column="2" Text="{Binding WeightDisplay}" FontSize="11" FontWeight="SemiBold" Foreground="#FFFF7B72" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                        <ListView.Footer>
                            <TextBlock x:Name="EmptyIndicatorsText" Text="No indicators detected. Click 'Analyze Static Only' to evaluate the sample." Padding="14" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                        </ListView.Footer>
                    </ListView>

                    <!-- Key Assessment Findings -->
                    <Border Padding="12,10" CornerRadius="8" Background="#161b22" BorderBrush="#30363d" BorderThickness="1">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Key Assessment Reasons" FontWeight="SemiBold" FontSize="12" Foreground="#FF58A6FF" />
                            <TextBlock x:Name="RiskReasonsText" Text="—" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right Column: Activity Log & Threat Report Preview -->
                <StackPanel Grid.Column="1" Spacing="8">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" FontSize="15" Text="Activity Log &amp; Threat Report" VerticalAlignment="Center" />
                    <TextBox x:Name="ThreatReportBox" FontFamily="Consolas" FontSize="11" MinHeight="410" MaxHeight="520" TextWrapping="Wrap" AcceptsReturn="True" IsReadOnly="True" Background="#0b1016" Foreground="#FF60DBEE" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
