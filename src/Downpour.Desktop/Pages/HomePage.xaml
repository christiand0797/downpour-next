<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="Downpour_Desktop.Pages.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="using:Downpour_Desktop.Pages"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">
    <ScrollViewer x:Name="PageScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  HorizontalScrollMode="Disabled" ZoomMode="Disabled">
        <StackPanel x:Name="HomeContent" Padding="24,20,24,36" Spacing="16" HorizontalAlignment="Stretch">
            <ContentControl x:Name="BlossomHost" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" />
            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Foreground="{StaticResource HudCyanBrush}" Text="DOWNPOUR  /  SYSTEM SUMMARY  /  LIVE" />
                    <TextBlock Style="{StaticResource TitleTextBlockStyle}" FontSize="30" Text="System overview" />
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="See the pressure, follow the trend, and identify what is using your system." TextWrapping="Wrap" />
                    <Button x:Name="StormModeButton" Content="⛈  RAIN MODE · STORM" Click="StormModeButton_Click"
                            Padding="12,7" HorizontalAlignment="Left" Background="#B30A1727"
                            BorderBrush="#8849D9EF" BorderThickness="1" Foreground="#FF8DEBFA"
                            FontSize="11" FontWeight="SemiBold"
                            ToolTipService.ToolTip="Cycle between drizzle, storm, thunderstorm, and hurricane. Choosing a mode locks it until you cycle again." />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Top">
                    <Border Padding="12,7" CornerRadius="9" BorderThickness="1" BorderBrush="#694CD6ED" Background="#AD071522">
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <Ellipse x:Name="SensorDot" Width="8" Height="8" Fill="#FF49E3C1" VerticalAlignment="Center" />
                            <TextBlock x:Name="SensorBadge" FontSize="12" FontWeight="SemiBold" Text="CONNECTING" />
                            <Button x:Name="UpdateButton" Content="⟳  Update Downpour" Click="UpdateButton_Click"
                                    Padding="10,6" Background="#B30A1727" BorderBrush="#8849D9EF" BorderThickness="1"
                                    Foreground="#FF8DEBFA" FontSize="11" FontWeight="SemiBold"
                                    ToolTipService.ToolTip="Check the latest stable release, verify its SHA-256 digest, and apply it when Downpour restarts. An internet connection is required." />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <Border Padding="14,11" CornerRadius="10" Background="{StaticResource HudPanelBrush}" BorderBrush="{StaticResource HudEdgeBrush}" BorderThickness="1">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE7BA;" FontSize="20" Foreground="{StaticResource HudCyanBrush}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock x:Name="SensorHeadline" FontWeight="SemiBold" Text="Connecting to the local sensor service" />
                        <TextBlock x:Name="SensorDescription" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Measurements appear when the read-only service is available." TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Padding="14,14,14,10" CornerRadius="12" Background="{StaticResource DownpourSurfaceBrush}" BorderBrush="{StaticResource DownpourStrokeBrush}" BorderThickness="1" VerticalAlignment="Stretch">
                    <StackPanel Spacing="8">
                        <TextBlock FontSize="11" FontWeight="SemiBold" CharacterSpacing="120" Foreground="{StaticResource HudTextDimBrush}" Text="LIVE LOAD" HorizontalAlignment="Center" />
                        <StackPanel x:Name="GaugeHost" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" />
                        <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="CPU and physical memory" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Padding="16,13" CornerRadius="12" Background="{StaticResource DownpourSurfaceBrush}" BorderBrush="{StaticResource DownpourStrokeBrush}" BorderThickness="1" SizeChanged="ResourceChartHost_SizeChanged">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock FontSize="14" FontWeight="SemiBold" Text="Resource history" />
                                <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="Live utilization · missing samples stay visible as gaps" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="5"><Ellipse Width="7" Height="7" Fill="#FF50DBF1" /><TextBlock FontSize="11" Text="CPU" /></StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="5"><Ellipse Width="7" Height="7" Fill="#FFB47AF8" /><TextBlock FontSize="11" Text="Memory" /></StackPanel>
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="1" MinHeight="138">
                            <Canvas x:Name="ResourceChart" IsHitTestVisible="False" AutomationProperties.Name="CPU and memory utilization history from zero to one hundred percent. Gaps indicate unavailable samples." />
                            <TextBlock x:Name="ChartEmpty" Text="Waiting for live samples to draw a trend" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <Grid Grid.Row="2" ColumnSpacing="10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="Oldest" />
                            <TextBlock Grid.Column="1" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="Last 2 minutes · live, every second" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="2" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="Now" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Padding="15" CornerRadius="10" Background="{StaticResource DownpourSurfaceElevatedBrush}" BorderBrush="{StaticResource DownpourMutedStrokeBrush}" BorderThickness="1">
                    <StackPanel Spacing="8"><TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Open threats" /><TextBlock x:Name="ThreatsMetricValue" FontSize="22" FontWeight="SemiBold" Text="—" /><TextBlock x:Name="ThreatsMetricDetail" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="Checking…" TextWrapping="Wrap" /></StackPanel>
                </Border>
                <Border Grid.Column="1" Padding="15" CornerRadius="10" Background="{StaticResource DownpourSurfaceElevatedBrush}" BorderBrush="{StaticResource DownpourMutedStrokeBrush}" BorderThickness="1">
                    <StackPanel Spacing="8"><TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Antivirus protection" /><TextBlock x:Name="AntivirusMetricValue" FontSize="22" FontWeight="SemiBold" Text="—" /><TextBlock x:Name="AntivirusMetricDetail" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="Checking…" TextWrapping="Wrap" /></StackPanel>
                </Border>
                <Border Grid.Column="2" Padding="15" CornerRadius="10" Background="{StaticResource DownpourSurfaceElevatedBrush}" BorderBrush="{StaticResource DownpourMutedStrokeBrush}" BorderThickness="1">
                    <StackPanel Spacing="8"><TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Hardening findings" /><TextBlock x:Name="HardeningMetricValue" FontSize="22" FontWeight="SemiBold" Text="—" /><TextBlock x:Name="HardeningMetricDetail" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="Checking…" TextWrapping="Wrap" /></StackPanel>
                </Border>
            </Grid>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Padding="15" CornerRadius="10" Background="{StaticResource DownpourSurfaceElevatedBrush}" BorderBrush="{StaticResource DownpourMutedStrokeBrush}" BorderThickness="1">
                    <StackPanel Spacing="8"><TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Processes observed" /><TextBlock x:Name="ProcessMetricValue" FontSize="22" FontWeight="SemiBold" Text="—" /><TextBlock x:Name="ProcessMetricDetail" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="Waiting for the local service" TextWrapping="Wrap" /></StackPanel>
                </Border>
                <Border Grid.Column="1" Padding="15" CornerRadius="10" Background="{StaticResource DownpourSurfaceElevatedBrush}" BorderBrush="{StaticResource DownpourMutedStrokeBrush}" BorderThickness="1">
                    <StackPanel Spacing="8"><TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Active TCP connections" /><TextBlock x:Name="TcpMetricValue" FontSize="22" FontWeight="SemiBold" Text="—" /><TextBlock x:Name="TcpMetricDetail" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="Waiting for network telemetry" TextWrapping="Wrap" /></StackPanel>
                </Border>
                <Border Grid.Column="2" Padding="15" CornerRadius="10" Background="{StaticResource DownpourSurfaceElevatedBrush}" BorderBrush="{StaticResource DownpourMutedStrokeBrush}" BorderThickness="1">
                    <StackPanel Spacing="8"><TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Last snapshot" /><TextBlock x:Name="SnapshotMetricValue" FontSize="22" FontWeight="SemiBold" Text="—" /><TextBlock x:Name="SnapshotMetricDetail" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="No current service data" TextWrapping="Wrap" /></StackPanel>
                </Border>
                <Border Grid.Column="3" Padding="15" CornerRadius="10" Background="{StaticResource DownpourSurfaceElevatedBrush}" BorderBrush="{StaticResource DownpourMutedStrokeBrush}" BorderThickness="1">
                    <StackPanel Spacing="8"><TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Sensor mode" /><TextBlock x:Name="SensorModeMetricValue" FontSize="22" FontWeight="SemiBold" Text="—" /><TextBlock x:Name="SensorModeMetricDetail" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="Service status unavailable" TextWrapping="Wrap" /></StackPanel>
                </Border>
            </Grid>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Spacing="3">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="PROCESS PRESSURE" />
                    <TextBlock FontSize="19" FontWeight="SemiBold" Text="Largest working sets" />
                </StackPanel>
                <TextBlock x:Name="ProcessWindowLabel" Grid.Column="1" VerticalAlignment="Bottom" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="TOP 8 · READ ONLY" />
            </Grid>
            <ListView ItemsSource="{x:Bind Processes}" SelectionMode="None" IsItemClickEnabled="False" Background="{StaticResource HudPanelBrush}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="12,9" ColumnSpacing="14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="2*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" Foreground="#FF5DCAE5" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <ProgressBar Style="{StaticResource HudMeterStyle}" Grid.Column="2" Minimum="0" Maximum="100" Value="{Binding MemoryShare}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="{Binding Detail}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
                <ListView.Footer>
                    <TextBlock Padding="12,10" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="Sorted by working set. Paths, command lines, and process response actions are not collected in this build." TextWrapping="Wrap" />
                </ListView.Footer>
            </ListView>
            <Border Padding="14,11" CornerRadius="9" Background="#9B08111C" BorderBrush="#3B39AFC5" BorderThickness="1">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="3"><TextBlock FontSize="10" CharacterSpacing="90" Foreground="{StaticResource HudTextDimBrush}" Text="DETECTION ENGINE" /><TextBlock x:Name="EngineStatusText" FontSize="12" Text="Checking the sensor service…" TextWrapping="Wrap" /></StackPanel>
                    <StackPanel Grid.Column="1" Spacing="3"><TextBlock FontSize="10" CharacterSpacing="90" Foreground="{StaticResource HudTextDimBrush}" Text="RESPONSE ACTIONS" /><TextBlock x:Name="ActionsStatusText" FontSize="12" Text="Checking action switches…" TextWrapping="Wrap" /></StackPanel>
                    <StackPanel Grid.Column="2" Spacing="3"><TextBlock FontSize="10" CharacterSpacing="90" Foreground="{StaticResource HudTextDimBrush}" Text="FEATURE MIGRATION" /><TextBlock x:Name="MigrationStatusText" FontSize="12" Text="" TextWrapping="Wrap" /></StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
