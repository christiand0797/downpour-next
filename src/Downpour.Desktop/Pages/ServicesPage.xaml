<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="Downpour_Desktop.Pages.ServicesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">
    <Grid Padding="24,20,24,30" RowSpacing="14">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Foreground="{StaticResource HudCyanBrush}" Text="DOWNPOUR  /  MONITORING  /  WINDOWS SERVICES" />
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" FontSize="30" Text="Services" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Inspect installed Windows services, current state, and startup type. Collection is local and read-only." TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="1" Content="Refresh now" Click="Refresh_Click" VerticalAlignment="Center" />
        </Grid>

        <Border Grid.Row="1" Padding="14,11" CornerRadius="10" Background="{StaticResource HudPanelBrush}" BorderBrush="{StaticResource HudEdgeBrush}" BorderThickness="1">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE713;" FontSize="20" Foreground="{StaticResource HudCyanBrush}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Spacing="3">
                    <TextBlock x:Name="StatusHeadline" FontWeight="SemiBold" Text="Connecting to the Windows Service Control Manager" />
                    <TextBlock x:Name="StatusDetail" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Service state comes from the local Service Control Manager. Startup type may be unknown or access denied." TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" RowSpacing="10">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <AutoSuggestBox x:Name="SearchBox" PlaceholderText="Filter by service name, display name, path, or risk reason" TextChanged="SearchBox_TextChanged" />
                <CheckBox Grid.Column="1" x:Name="ShowClean" Content="Show clean services" IsChecked="True" Checked="ShowClean_Changed" Unchecked="ShowClean_Changed" />
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                    <TextBlock x:Name="ServiceCount" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="—" HorizontalAlignment="Right" />
                    <TextBlock x:Name="RiskSummary" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Right" />
                </StackPanel>
            </Grid>
            <Grid Grid.Row="1" Padding="12,9" ColumnSpacing="12" Background="{StaticResource DownpourSurfaceElevatedBrush}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="0.8*" /></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="4" FontSize="10" FontWeight="SemiBold" CharacterSpacing="65" Text="RISK" />
                <TextBlock FontSize="10" FontWeight="SemiBold" CharacterSpacing="65" Text="SERVICE NAME" />
                <TextBlock Grid.Column="1" FontSize="10" FontWeight="SemiBold" CharacterSpacing="65" Text="DISPLAY NAME" />
                <TextBlock Grid.Column="2" FontSize="10" FontWeight="SemiBold" CharacterSpacing="65" Text="STATE" />
                <TextBlock Grid.Column="3" FontSize="10" FontWeight="SemiBold" CharacterSpacing="65" Text="STARTUP TYPE" />
            </Grid>
            <ListView x:Name="ServiceList" Grid.Row="2" ItemsSource="{x:Bind Services}" SelectionMode="None" IsItemClickEnabled="False" Background="{StaticResource DownpourSurfaceBrush}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="12,8" ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="0.8*" /></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding ServiceName}" FontFamily="Consolas" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DisplayName}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding RiskDetail}" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock Grid.Column="4" Text="{Binding Risk}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding RiskBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding State}" FontSize="11" Foreground="{Binding StateBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="{Binding StartupType}" FontSize="11" Foreground="{Binding StartupBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
                <ListView.Footer>
                    <TextBlock x:Name="EmptyState" Padding="14" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="No matching services were reported." TextWrapping="Wrap" />
                </ListView.Footer>
            </ListView>
        </Grid>

        <TextBlock Grid.Row="3" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="Inventory only · start, stop, disable, and configuration changes are not available here. Risk ports v29's remote-access service rules (disabled services rated Low) and adds unquoted-path and writable-folder checks; binary signatures are not verified yet. Access-denied or unknown values are never inferred." TextWrapping="Wrap" />
    </Grid>
</Page>
