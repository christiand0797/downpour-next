<Page
    x:Class="Downpour_Desktop.Pages.IoTPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="16" Margin="24,16,24,24">

            <!-- Header Section -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="IoT Device Security" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource HudTextBrush}" />
                        <Border x:Name="StatusBadge" CornerRadius="4" Padding="8,2" VerticalAlignment="Center" Background="{StaticResource HudPanelElevatedBrush}">
                            <TextBlock x:Name="StatusBadgeText" Text="IDLE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource HudTextDimBrush}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Subnet device discovery, OUI vendor fingerprinting, and Mozi / Mirai / Kimwolf botnet indicator detection."
                               FontSize="13" Foreground="{StaticResource HudTextDimBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button x:Name="ScanButton" Click="ScanButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE72C;" FontSize="13" />
                            <TextBlock Text="Scan Network" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ProbeButton" Click="ProbeButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE774;" FontSize="13" />
                            <TextBlock Text="Probe Selected" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="BlockButton" Click="BlockButton_Click" Background="{StaticResource HudRedTintBrush}" BorderBrush="{StaticResource HudRedBrush}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE7BA;" FontSize="13" Foreground="{StaticResource HudRedBrush}" />
                            <TextBlock Text="Block Device" Foreground="{StaticResource HudRedBrush}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ExportReportButton" Click="ExportReportButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xEDE1;" FontSize="13" />
                            <TextBlock Text="Export Report" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Metrics Overview Cards -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource HudPanelBrush}" BorderBrush="{StaticResource HudStrokeMutedBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                    <StackPanel Spacing="4">
                        <TextBlock Text="DISCOVERED DEVICES" FontSize="11" FontWeight="Bold" Foreground="{StaticResource HudTextDimBrush}" />
                        <TextBlock x:Name="MetricTotalDevices" Text="0" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource HudCyanBrush}" />
                        <TextBlock Text="Local ARP table entries" FontSize="12" Foreground="{StaticResource HudTextFaintBrush}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="{StaticResource HudPanelBrush}" BorderBrush="{StaticResource HudStrokeMutedBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                    <StackPanel Spacing="4">
                        <TextBlock Text="BOTNET THREATS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource HudTextDimBrush}" />
                        <TextBlock x:Name="MetricBotnetThreats" Text="0" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource HudGreenBrush}" />
                        <TextBlock Text="Mozi / Mirai / Kimwolf flags" FontSize="12" Foreground="{StaticResource HudTextFaintBrush}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="{StaticResource HudPanelBrush}" BorderBrush="{StaticResource HudStrokeMutedBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                    <StackPanel Spacing="4">
                        <TextBlock Text="SMART HOME / IOT" FontSize="11" FontWeight="Bold" Foreground="{StaticResource HudTextDimBrush}" />
                        <TextBlock x:Name="MetricSmartHome" Text="0" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource HudAmberBrush}" />
                        <TextBlock Text="Espressif, Tuya, Xiaomi" FontSize="12" Foreground="{StaticResource HudTextFaintBrush}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Background="{StaticResource HudPanelBrush}" BorderBrush="{StaticResource HudStrokeMutedBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                    <StackPanel Spacing="4">
                        <TextBlock Text="CAMERAS &amp; DVRS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource HudTextDimBrush}" />
                        <TextBlock x:Name="MetricCameras" Text="0" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource HudVioletBrush}" />
                        <TextBlock Text="Hikvision, Dahua, RTSP" FontSize="12" Foreground="{StaticResource HudTextFaintBrush}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Search and Filter Bar -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox x:Name="SearchBox" Grid.Column="0" PlaceholderText="Search devices by IP, MAC, vendor, or category..."
                         TextChanged="SearchBox_TextChanged" />

                <ComboBox x:Name="FilterCombo" Grid.Column="1" SelectionChanged="FilterCombo_SelectionChanged" SelectedIndex="0" Width="180">
                    <ComboBoxItem Content="All Devices" />
                    <ComboBoxItem Content="Threats Only" />
                    <ComboBoxItem Content="Smart Home Only" />
                    <ComboBoxItem Content="Cameras Only" />
                </ComboBox>
            </Grid>

            <!-- Devices List and Deep Inspection Grid -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <!-- Devices List -->
                <Border Grid.Column="0" Background="{StaticResource HudPanelBrush}" BorderBrush="{StaticResource HudStrokeMutedBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Discovered Subnet Devices" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource HudTextBrush}" />
                        <ListView x:Name="DevicesList" SelectionMode="Single" Height="360">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource HudPanelElevatedBrush}" BorderBrush="{StaticResource HudStrokeMutedBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,3,0,3">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Spacing="4">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{Binding IpAddress}" FontWeight="SemiBold" Foreground="{StaticResource HudTextBrush}" FontSize="13" />
                                                    <Border CornerRadius="3" Padding="6,1" VerticalAlignment="Center"
                                                            Background="{Binding ThreatBackground}">
                                                        <TextBlock Text="{Binding ThreatText}" FontSize="10" FontWeight="Bold" Foreground="{Binding ThreatForeground}" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding VendorSummary}" FontSize="11" Foreground="{StaticResource HudTextDimBrush}" />
                                                <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,2,0,0">
                                                    <TextBlock Text="{Binding MacSummary}" FontSize="11" Foreground="{StaticResource HudBlueBrush}" />
                                                    <TextBlock Text="{Binding CategorySummary}" FontSize="11" Foreground="{StaticResource HudAmberBrush}" />
                                                    <TextBlock Text="{Binding PortsSummary}" FontSize="11" Foreground="{StaticResource HudGreenBrush}" />
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="2">
                                                <TextBlock Text="{Binding ScoreSummary}" FontSize="12" FontWeight="SemiBold" Foreground="{Binding ThreatForeground}" HorizontalAlignment="Right" />
                                                <TextBlock Text="{Binding BotnetAlert}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource HudRedBrush}" HorizontalAlignment="Right" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <!-- Deep Inspection Card -->
                <Border Grid.Column="1" Background="{StaticResource HudPanelBrush}" BorderBrush="{StaticResource HudStrokeMutedBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Device Deep Inspection" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource HudTextBrush}" />
                        <Border x:Name="InspectionCard" Background="{StaticResource HudPanelElevatedBrush}" BorderBrush="{StaticResource HudStrokeMutedBrush}" BorderThickness="1" CornerRadius="6" Padding="12">
                            <StackPanel Spacing="8">
                                <TextBlock x:Name="SelectedDeviceHeader" Text="Select a device to inspect" FontWeight="SemiBold" Foreground="{StaticResource HudTextBrush}" FontSize="14" />
                                <TextBlock x:Name="SelectedDeviceVendor" Text="Vendor: --" FontSize="12" Foreground="{StaticResource HudTextDimBrush}" />
                                <TextBlock x:Name="SelectedDeviceMac" Text="MAC: --" FontSize="12" Foreground="{StaticResource HudBlueBrush}" />
                                <TextBlock x:Name="SelectedDeviceCategory" Text="Category: --" FontSize="12" Foreground="{StaticResource HudAmberBrush}" />
                                <TextBlock x:Name="SelectedDeviceThreat" Text="Threat Level: Clean" FontSize="12" Foreground="{StaticResource HudGreenBrush}" />
                                <TextBlock x:Name="SelectedDeviceScore" Text="Risk Score: 0/100" FontSize="12" Foreground="{StaticResource HudTextDimBrush}" />

                                <TextBlock Text="Open Services &amp; Ports:" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource HudTextBrush}" Margin="0,4,0,0" />
                                <TextBlock x:Name="SelectedDeviceServices" Text="None probed yet (click 'Probe Selected')" FontSize="11" Foreground="{StaticResource HudTextDimBrush}" TextWrapping="Wrap" />

                                <TextBlock Text="Botnet Threat Indicators:" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource HudTextBrush}" Margin="0,4,0,0" />
                                <TextBlock x:Name="SelectedDeviceBotnets" Text="No botnet signatures detected" FontSize="11" Foreground="{StaticResource HudGreenBrush}" TextWrapping="Wrap" />

                                <TextBlock Text="Recommended Action:" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource HudTextBrush}" Margin="0,4,0,0" />
                                <TextBlock x:Name="SelectedDeviceAction" Text="Normal network device. No isolation needed." FontSize="11" Foreground="{StaticResource HudTextDimBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Activity Log Card -->
            <Border Background="{StaticResource HudPanelBrush}" BorderBrush="{StaticResource HudStrokeMutedBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                <StackPanel Spacing="6">
                    <TextBlock Text="IoT Activity &amp; Scan Log" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource HudTextBrush}" />
                    <TextBox x:Name="LogTextBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                             Height="100" FontFamily="Consolas" FontSize="11" Background="#030712" Foreground="{StaticResource HudTextDimBrush}"
                             BorderBrush="{StaticResource HudStrokeMutedBrush}" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
